        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 메모를 녹음하려면 마이크 권한이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制语音备忘录需要麦克风权限。"
