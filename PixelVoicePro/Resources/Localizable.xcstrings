    "booth.live_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words will appear here live. You can hide this panel anytime to save battery during a long session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras aparecerán aquí en vivo. Puedes ocultar este panel en cualquier momento para ahorrar batería durante una clase larga."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras aparecerão aqui ao vivo. Você pode ocultar este painel a qualquer momento para economizar bateria em uma sessão longa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras aparecerão aqui em direto. Pode ocultar este painel a qualquer momento para poupar bateria numa sessão longa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слова будут появляться здесь в реальном времени. Эту панель можно скрыть в любой момент для экономии заряда."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 단어가 실시간으로 표시됩니다. 긴 세션 중 배터리를 절약하려면 언제든지 이 패널을 숨길 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字将在此实时显示。长时间录音时您可以随时隐藏此面板以节省电量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字會在此即時顯示。長時間錄音時您可以隨時隱藏此面板以節省電量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに言葉がリアルタイムで表示されます。長時間の録音中にバッテリーを節約するため、いつでもこのパネルを隠せます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots apparaîtront ici en direct. Vous pouvez masquer ce panneau à tout moment pour économiser la batterie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wörter erscheinen hier live. Sie können dieses Feld jederzeit ausblenden, um bei langen Sitzungen Akku zu sparen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parole appariranno qui dal vivo. Puoi nascondere questo pannello in qualsiasi momento per risparmiare batteria."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر الكلمات هنا مباشرة. يمكنك إخفاء هذه اللوحة في أي وقت لتوفير البطارية أثناء الجلسات الطويلة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शब्द यहाँ लाइव दिखाई देंगे। लंबे सत्र में बैटरी बचाने के लिए आप इस पैनल को कभी भी छिपा सकते हैं।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelimeler burada canlı olarak görünecektir. Uzun oturumlarda pil tasarrufu için bu paneli istediğiniz zaman gizleyebilirsiniz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Woorden verschijnen hier live. Je kunt dit paneel altijd verbergen om batterij te besparen tijdens een lange sessie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słowa będą się tu pojawiać na żywo. Możesz ukryć ten panel w dowolnym momencie, aby oszczędzać baterię."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слова з'являтимуться тут у реальному часі. Цю панель можна сховати будь-коли для економії заряду."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata-kata akan muncul langsung di sini. Anda dapat menyembunyikan panel ini kapan saja untuk menghemat baterai."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các từ sẽ hiển thị trực tiếp tại đây. Bạn có thể ẩn bảng này bất kỳ lúc nào để tiết kiệm pin khi ghi âm dài."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำพูดจะปรากฏที่นี่แบบสดๆ คุณสามารถซ่อนแผงนี้ได้ตลอดเวลาเพื่อประหยัดแบตเตอรี่ระหว่างการบันทึกนานๆ"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ord visas här live. Du kan dölja den här panelen när som helst för att spara batteri under långa sessioner."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ord vises her live. Du kan når som helst skjule dette panel for at spare batteri under lange sessioner."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ord vises her direkte. Du kan skjule dette panelet når som helst for å spare batteri under lange økter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanat näkyvät tässä reaaliajassa. Voit piilottaa tämän paneelin milloin tahansa säästääksesi akkua."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι λέξεις θα εμφανίζονται εδώ ζωντανά. Μπορείτε να αποκρύψετε αυτό το πλαίσιο ανά πάσα στιγμή για εξοικονόμηση μπαταρίας."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מילים יופיעו כאן בשידור חי. ניתן להסתיר חלונית זו בכל עת כדי לחסוך בסוללה."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slova se zde budou zobrazovat živě. Tento panel můžete kdykoli skrýt a šetřit tak baterii."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuvintele vor apărea aici în direct. Poți ascunde acest panou oricând pentru a economisi bateria."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szavak itt élőben jelennek meg. Ezt a panelt bármikor elrejtheted az akkumulátor kíméléséhez."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkataan akan muncul secara langsung di sini. Anda boleh menyembunyikan panel ini pada bila-bila masa untuk menjimatkan bateri."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paraules apareixeran aquí en directe. Pots amagar aquest panell en qualsevol moment per estalviar bateria."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Riječi će se ovdje prikazivati uživo. Ovu ploču možete sakriti u bilo kojem trenutku radi uštede baterije."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Slová sa tu budú zobrazovať naživo. Tento panel môžete kedykoľvek skryť a šetriť tak batériu."
          }
        }
      }
    },
