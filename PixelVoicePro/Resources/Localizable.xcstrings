    "ai.refine.fix_text_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refines spelling, capitalization, and context using %@ while keeping word timestamps synced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Afina ortografía, mayúsculas y coherencia usando %@ manteniendo sincronizados los tiempos de cada palabra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Refina ortografia, maiúsculas e contexto usando %@ mantendo os tempos das palavras sincronizados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Refina ortografia, maiúsculas e contexto usando %@ mantendo os tempos das palavras sincronizados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уточняет орфографию, заглавные буквы и контекст через %@, сохраняя привязку слов ко времени."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 사용해 철자·대소문자·문맥을 다듬으면서 단어별 타임스탬프 동기화를 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@ 优化拼写、大小写和上下文语意，同时保留逐词时间轴同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@ 優化錯字、大小寫與上下文語意，同時保留逐詞時間軸同步。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で誤字や大文字・文脈を整えつつ、単語ごとのタイムスタンプ同期を維持します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affine l'orthographe, les majuscules et le contexte via %@ tout en gardant la synchro mot à mot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbessert Rechtschreibung, Großschreibung und Kontext mit %@ bei voller Wort-Zeitsynchronisierung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rifinisce ortografia, maiuscole e contesto con %@ mantenendo sincronizzati i tempi parola per parola."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينقح الإملاء والحروف والسياق باستخدام %@ مع الحفاظ على تزامن توقيت كل كلمة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ की मदद से वर्तनी और संदर्भ सुधारता है और शब्दों के टाइमस्टैम्प सिंक रखता है।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kullanarak yazımı, büyük harfleri ve bağlamı iyileştirirken kelime zaman damgalarını korur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbetert spelling, hoofdletters en context met %@ met behoud van woordsynchronisatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprawia pisownię, wielkie litery i kontekst za pomocą %@, zachowując synchronizację czasu słów."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уточнює правопис, регістр і контекст через %@, зберігаючи синхронізацію слів у часі."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyempurnakan ejaan, huruf kapital, dan konteks dengan %@ sambil menjaga sinkronisasi waktu kata."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trau chuốt chính tả, viết hoa và ngữ cảnh bằng %@ mà vẫn giữ nguyên mốc thời gian từng từ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับปรุงตัวสะกดและบริบทด้วย %@ โดยยังคงซิงก์เวลาแต่ละคำไว้ครบถ้วน"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förfinar stavning, versaler och sammanhang med %@ med bibehållen ordsynkronisering."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forfiner stavning, store bogstaver og kontekst med %@ med synkroniserede ordtider."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbedrer staving, store bokstaver og kontekst med %@ og beholder tidsstempling per ord."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Parantaa oikeinkirjoitusta ja selkeyttä (%@) säilyttäen sanojen aikatäsmäyksen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βελτιώνει ορθογραφία, κεφαλαία και νόημα με %@ διατηρώντας τον συγχρονισμό λέξεων."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משפר איות, אותיות גדולות והקשר באמצעות %@ תוך שמירה על סנכרון הזמנים של כל מילה."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vylepší pravopis a kontext pomocí %@ při zachování časové synchronizace slov."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rafinează ortografia, majusculele și contextul cu %@ păstrând sincronizarea cuvintelor."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Javítja a helyesírást és szövegkörnyezetet (%@) a szavak időszinkronjának megőrzésével."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memperhalusi ejaan, huruf besar dan konteks menggunakan %@ sambil mengekalkan penyegerakan masa kata."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afina ortografia, majúscules i context amb %@ mantenint els temps de cada paraula sincronitzats."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poboljšava pravopis, velika slova i kontekst pomoću %@ uz očuvanje vremenske sinkronizacije."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zlepší pravopis a kontext pomocou %@ pri zachovaní časovej synchronizácie slov."
          }
        }
      }
    },
