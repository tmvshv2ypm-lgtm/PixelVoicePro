    "folder.empty.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the red button below to record directly in this folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa el botón rojo inferior para grabar directamente en esta carpeta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão vermelho abaixo para gravar diretamente nesta pasta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão vermelho abaixo para gravar diretamente nesta pasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите красную кнопку ниже, чтобы записать прямо в эту папку."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더에 바로 녹음하려면 아래 빨간색 버튼을 누르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击下方的红色按钮即可直接录制到此文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選下方的紅色按鈕即可直接錄製到此資料夾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の赤いボタンをタップすると、このフォルダに直接録音できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le bouton rouge ci-dessous pour enregistrer directement dans ce dossier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie unten auf die rote Taste, um direkt in diesen Ordner aufzunehmen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il pulsante rosso in basso per registrare direttamente in questa cartella."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الزر الأحمر بالأسفل للتسجيل مباشرة في هذا المجلد."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोल्डर में सीधे रिकॉर्ड करने के लिए नीचे लाल बटन पर टैप करें।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrudan bu klasöre kaydetmek için aşağıdaki kırmızı düğmeye dokunun."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de rode knop onderaan om direct in deze map op te nemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij czerwonego przycisku poniżej, aby nagrywać bezpośrednio do tego folderu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть червону кнопку нижче, щоб записувати безпосередньо в цю папку."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tombol merah di bawah untuk merekam langsung di folder ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào nút màu đỏ bên dưới để ghi âm trực tiếp vào thư mục này."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะปุ่มสีแดงด้านล่างเพื่อบันทึกลงในโฟลเดอร์นี้โดยตรง"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på den röda knappen nedan för att spela in direkt i den här mappen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på den røde knap nedenfor for at optage direkte i denne mappe."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på den røde knappen nedenfor for å ta opp direkte i denne mappen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta alla olevaa punaista painiketta tallentaaksesi suoraan tähän kansioon."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε το κόκκινο κουμπί παρακάτω για εγγραφή απευθείας σε αυτόν τον φάκελο."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על הכפתור האדום למטה כדי להקליט ישירות לתיקייה זו."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na červené tlačítko níže nahrajete záznam přímo do této složky."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge butonul roșu de mai jos pentru a înregistra direct în acest dosar."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints az alábbi piros gombra a közvetlen ebbe a mappába történő felvételhez."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik butang merah di bawah untuk merakam terus dalam folder ini."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Prem el botó vermell inferior per gravar directament en aquesta carpeta."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite crveni gumb ispod za izravno snimanje u ovu mapu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na červené tlačidlo nižšie nahráte záznam priamo do tohto priečinka."
          }
        }
      }
    },
