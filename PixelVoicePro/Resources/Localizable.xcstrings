    "tags.section.default_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default folders can be hidden from the home screen using the eye icon, but cannot be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las carpetas predeterminadas se pueden ocultar de la pantalla principal con el ícono del ojo, pero no se eliminan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pastas padrão podem ser ocultadas da tela inicial com o ícone de olho, mas não podem ser apagadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As pastas predefinidas podem ser ocultadas do ecrã inicial com o ícone de olho, mas não são eliminadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандартные папки можно скрыть с главного экрана с помощью значка глаза, но удалить их нельзя."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 폴더는 눈 아이콘으로 홈 화면에서 숨길 수 있지만 삭제할 수는 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认文件夹可通过眼睛图标在主屏幕隐藏，但无法删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設資料夾可透過眼睛圖示在主畫面隱藏，但無法刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトフォルダは目のアイコンでホーム画面から非表示にできますが、削除はできません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers par défaut peuvent être masqués de l'écran d'accueil avec l'icône œil, mais ne peuvent pas être supprimés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardordner können über das Augensymbol ausgeblendet, aber nicht gelöscht werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cartelle predefinite possono essere nascoste dalla schermata Home con l'icona dell'occhio, ma non eliminate."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن إخفاء المجلدات الافتراضية من الشاشة الرئيسية باستخدام أيقونة العين، ولكن لا يمكن حذفها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट फ़ोल्डर को आंख आइकन से होम स्क्रीन से छिपाया जा सकता है, लेकिन हटाया नहीं जा सकता।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan klasörler göz simgesiyle ana ekrandan gizlenebilir ancak silinemez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaardmappen kunnen met het oogpictogram worden verborgen, maar niet verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślne foldery można ukryć na ekranie głównym ikoną oka, ale nie można ich usunąć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандартні папки можна сховати з головного екрана значком ока, але їх не можна видалити."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder bawaan dapat disembunyikan dari layar utama menggunakan ikon mata, tetapi tidak dapat dihapus."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể ẩn thư mục mặc định khỏi màn hình chính bằng biểu tượng mắt, nhưng không thể xóa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สามารถซ่อนโฟลเดอร์เริ่มต้นจากหน้าจอหลักได้ด้วยไอคอนรูปตา แต่ไม่สามารถลบได้"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmappar kan döljas från startskärmen med ögonikonen, men kan inte raderas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmapper kan skjules fra startskærmen med øjeikonet, men kan ikke slettes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmapper kan skjules fra startskjermen med øyeikonet, men kan ikke slettes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletuskansiot voidaan piilottaa aloitusnäytöstä silmäkuvakkeella, mutta niitä ei voi poistaa."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προεπιλεγμένοι φάκελοι μπορούν να αποκρυφτούν με το εικονίδιο ματιού, αλλά δεν διαγράφονται."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להסתיר תיקיות ברירת מחדל ממסך הבית באמצעות סמל העין, אך לא למחוק אותן."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výchozí složky lze skrýt z domovské obrazovky ikonou oka, nelze je však smazat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosarele implicite pot fi ascunse de pe ecranul principal cu pictograma ochi, dar nu pot fi șterse."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alapértelmezett mappák elrejthetők a kezdőképernyőről a szem ikonnal, de nem törölhetők."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder lalai boleh disembunyikan daripada skrin utama menggunakan ikon mata, tetapi tidak boleh dipadamkan."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les carpetes predeterminades es poden amagar de la pantalla principal amb la icona de l'ull, però no s'eliminen."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadane mape mogu se sakriti s početnog zaslona ikonom oka, ali se ne mogu izbrisati."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predvolené priečinky možno skryť z domovskej obrazovky ikonou oka, ale nedajú sa vymazať."
          }
        }
      }
    },
