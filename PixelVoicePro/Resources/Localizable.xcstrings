    "theme.picker.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل السمات الهادئة على تحديث مجلدات Liquid Glass والألوان المميزة مع الحفاظ على الخلفية الفاتحة والداكنة ومفاتيح iPhone الخضراء وألوان المتحدثين."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els temes subtils adapten les carpetes Liquid Glass i els accents principals conservant els fons clar/fosc del sistema, els interruptors verds d’iPhone, els colors de locutors i les franges horàries."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemné motivy upraví složky Liquid Glass a hlavní akcenty při zachování světlého/tmavého pozadí, zelených přepínačů iPhonu, barev mluvčích a denní doby."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afdæmpede temaer opdaterer Liquid Glass-mapper og nøgleaccenter, mens lys/mørk baggrund, grønne iPhone-kontakter, talerfarver og tidspunkter bevares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezente Designs passen Liquid-Glass-Ordner und Hauptakzente an und behalten System-Hintergründe, grüne iPhone-Schalter, Sprecherfarben und Tageszeiten bei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα διακριτικά θέματα προσαρμόζουν τους φακέλους Liquid Glass και τις βασικές λεπτομέρειες διατηρώντας το ανοιχτό/σκοτεινό φόντο, τους πράσινους διακόπτες iPhone, τα χρώματα ομιλητών και την ώρα ημέρας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtle themes update Liquid Glass folders and key accents while keeping system Light/Dark backgrounds, green iPhone switches, speaker colors, and time-of-day badges."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los temas sutiles adaptan las carpetas Liquid Glass y los acentos principales conservando los fondos Claro/Oscuro del sistema, los interruptores verdes de iPhone, los colores de locutores y las franjas horarias."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hienovaraiset teemat päivittävät Liquid Glass -kansiot ja korostukset säilyttäen vaalean/tumman taustan, vihreät iPhone-kytkimet, puhujavärit ja vuorokaudenajat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les thèmes subtils adaptent les dossiers Liquid Glass et les accents clés tout en conservant les fonds clair/sombre, les interrupteurs verts iOS, les couleurs des intervenants et les moments de la journée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ערכות נושא עדינות מעדכנות את תיקיות ה-Liquid Glass וההדגשות תוך שמירה על רקע בהיר/כהה, מתגי אייפון ירוקים וצבעי דוברים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूक्ष्म थीम सिस्टम लाइट/डार्क बैकग्राउंड, हरे iPhone स्विच, वक्ता रंग और समय बैज सुरक्षित रखते हुए Liquid Glass फ़ोल्डर और मुख्य रंग अपडेट करती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suptilne teme mijenjaju Liquid Glass mape i glavne naglaske zadržavajući svijetlu/tamnu pozadinu, zelene iPhone prekidače, boje govornika i doba dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A visszafogott témák frissítik a Liquid Glass mappákat és fő kiemeléseket, miközben megőrzik a világos/sötét hátteret, a zöld iPhone-kapcsolókat, a beszélőszíneket és a napszakokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema halus memperbarui folder Liquid Glass dan aksen utama sambil tetap mempertahankan latar Terang/Gelap, sakelar hijau iPhone, warna pembicara, dan waktu hari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I temi discreti aggiornano cartelle Liquid Glass e accenti principali mantenendo sfondi chiaro/scuro, interruttori verdi iPhone, colori dei relatori e fasce orarie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "控えめなテーマは、システムのライト/ダーク背景、iPhoneの緑色のスイッチ、話者カラー、時間帯バッジを保ったまま Liquid Glass フォルダと主要アクセントを変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은은한 테마는 시스템 라이트/다크 배경, 기본 초록색 스위치, 화자 색상 및 시간대 배지를 유지하면서 Liquid Glass 폴더와 주요 강조 색상을 변경합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema halus mengemas kini folder Liquid Glass dan aksen utama sambil mengekalkan latar Cerah/Gelap, suis hijau iPhone, warna penutur dan waktu hari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtile temaer oppdaterer Liquid Glass-mapper og hovedaksenter mens lys/mørk bakgrunn, grønne iPhone-brytere, talerfarger og tid på dagen beholdes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtiele thema’s passen Liquid Glass-mappen en accenten aan terwijl systeemachtergronden, groene iPhone-schakelaars, sprekerskleuren en dagdelen behouden blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtelne motywy zmieniają foldery Liquid Glass i główne akcenty, zachowując tło jasne/ciemne, zielone przełączniki iPhone’a, kolory mówców i pory dnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Temas sutis atualizam pastas Liquid Glass e destaques mantendo os fundos Claro/Escuro, os botões verdes do iPhone, cores de locutores e períodos do dia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os temas subtis atualizam as pastas Liquid Glass e destaques mantendo os fundos Claro/Escuro, os interruptores verdes do iPhone, cores dos locutores e períodos do dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Temele subtile actualizează dosarele Liquid Glass și accentele principale păstrând fundalul luminos/întunecat, comutatoarele verzi de iPhone, culorile vorbitorilor și perioadele zilei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деликатные темы обновляют папки Liquid Glass и основные акценты, сохраняя светлый/тёмный фон, зелёные переключатели iPhone, цвета дикторов и время суток."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemné motívy upravia priečinky Liquid Glass a hlavné akcenty pri zachovaní svetlého/tmavého pozadia, zelených prepínačov iPhonu, farieb hovoriacich a denného času."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtila teman uppdaterar Liquid Glass-mappar och huvudaccenter medan systemets ljusa/mörka bakgrund, gröna iPhone-reglage, talarfärger och tid på dagen bevaras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ธีมแบบนุ่มนวลจะปรับสีโฟลเดอร์ Liquid Glass และสีเน้นหลัก โดยคงพื้นหลังโหมดสว่าง/มืด สวิตช์สีเขียวของ iPhone สีผู้พูด และช่วงเวลาไว้เหมือนเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarif temalar sistem açık/koyu arka planlarını, yeşil iPhone anahtarlarını, konuşmacı renklerini ve gün dilimi rozetlerini koruyarak Liquid Glass klasörlerini ve ana vurguları günceller."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Делікатні теми оновлюють теки Liquid Glass та основні акценти, зберігаючи світлий/темний фон, зелені перемикачі iPhone, кольори мовців і час доби."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chủ đề tinh tế cập nhật thư mục Liquid Glass và màu nhấn chính trong khi vẫn giữ nền Sáng/Tối, công tắc xanh của iPhone, màu người nói và buổi trong ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "柔和主题会在保留系统浅色/深色背景、iPhone 绿色开关、说话人颜色与时段图标的前提下，更新 Liquid Glass 文件夹和主要强调色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "柔和主題會在保留系統淺色/深色背景、iPhone 綠色開關、講者顏色與時段圖示的前提下，更新 Liquid Glass 資料夾與主要強調色。"
          }
        }
      }
    },
