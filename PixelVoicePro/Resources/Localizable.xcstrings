    "sample3.bm1.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never use ambiguous relative dates"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prohibido usar fechas ambiguas"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca usar datas relativas ambíguas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca usar datas relativas ambíguas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никаких расплывчатых относительных дат"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모호한 상대 날짜 사용 금지"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁止使用模糊的相对日期"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "禁止使用模糊的相對日期"
          }
        },
