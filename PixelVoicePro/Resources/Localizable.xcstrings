    "format.wav.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uncompressed studio audio (~5.5 MB/min). Maximum dynamic range for deep acoustic analysis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio de estudio sin compresión (~5.5 MB/min). Máximo rango dinámico para análisis acústico profundo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Áudio de estúdio sem compressão (~5,5 MB/min). Alcance dinâmico máximo para análise acústica profunda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
