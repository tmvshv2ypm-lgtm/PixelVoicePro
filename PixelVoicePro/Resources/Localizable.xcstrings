    "detail.no_acoustic_events": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No non-verbal events (laughter, applause, music, or long pauses) were detected in this recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se detectaron eventos no verbales (risas, aplausos, música o pausas largas) en esta grabación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum evento não verbal (risos, aplausos, música ou pausas longas) foi detectado nesta gravação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foram detetados eventos não verbais (risos, aplausos, música ou pausas longas) nesta gravação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невербальные события (смех, аплодисменты, музыка или длинные паузы) не обнаружены."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 녹음에서 비언어적 이벤트(웃음, 박수, 음악 또는 긴 침묵)가 감지되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此录音中未检测到非语言事件（笑声、掌声、音乐或长停顿）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此錄音中未偵測到非語言事件（笑聲、掌聲、音樂或長停頓）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この録音では非言語イベント（笑い声、拍手、音楽、長い無音）は検出されませんでした。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun événement non verbal (rires, applaudissements, musique ou longues pauses) détecté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine nonverbalen Ereignisse (Lachen, Applaus, Musik oder lange Pausen) erkannt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun evento non verbale (risate, applausi, musica o pause lunghe) rilevato."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم اكتشاف أحداث غير لفظية (ضحك أو تصفيق أو موسيقى أو توقفات طويلة) في هذا التسجيل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रिकॉर्डिंग में कोई गैर-शाब्दिक घटना (हंसी, तालियां, संगीत या लंबा विराम) नहीं मिली।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kayıtta sözel olmayan olay (kahkaha, alkış, müzik veya uzun duraklama) algılanmadı."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen non-verbale gebeurtenissen (gelach, applaus, muziek of lange pauzes) gedetecteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wykryto zdarzeń niewerbalnych (śmiechu, oklasków, muzyki ani długich przerw)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цьому записі не виявлено невербальних подій (сміху, оплесків, музики чи довгих пауз)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada peristiwa non-verbal (tawa, tepuk tangan, musik, atau jeda panjang) yang terdeteksi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không phát hiện sự kiện phi ngôn ngữ (tiếng cười, vỗ tay, nhạc hoặc khoảng lặng dài)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบเหตุการณ์ที่ไม่ใช่คำพูด (เสียงหัวเราะ ปรบมือ ดนตรี หรือการหยุดนาน) ในการบันทึกนี้"
