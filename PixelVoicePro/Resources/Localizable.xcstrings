        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉइस नोट्स रिकॉर्ड करने के लिए माइक्रोफ़ोन की अनुमति आवश्यक है।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesli not kaydetmek için mikrofon izni gereklidir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfoontoegang is vereist om spraakmemo's op te nemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uprawnienie do mikrofonu jest wymagane do nagrywania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для запису голосових нотаток потрібен дозвіл на мікрофон."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
