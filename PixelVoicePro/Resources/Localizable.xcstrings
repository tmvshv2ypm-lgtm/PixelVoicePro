    "trash.info_banner": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ تسجيل · %2$@ في السلة. يتم الحذف النهائي بعد %3$@ يوماً."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nota/es · %2$@ a la paperera. S’eliminen definitivament als %3$@ dies."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ záznam(y) · %2$@ v koši. Trvalé odstranění po %3$@ dnech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ optagelse(r) · %2$@ i papirkurv. Slettes permanent efter %3$@ dage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Aufnahme(n) · %2$@ im Papierkorb. Endgültige Löschung nach %3$@ Tagen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ εγγραφή(ές) · %2$@ στον κάδο. Οριστική διαγραφή μετά από %3$@ ημέρες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ recording(s) · %2$@ recoverable. Notes are permanently removed after %3$@ days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nota(s) · %2$@ en papelera. Se eliminan definitivamente tras %3$@ días."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tallenne(tta) · %2$@ roskakorissa. Poistetaan pysyvästi %3$@ päivän kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ note(s) · %2$@ dans la corbeille. Suppression définitive après %3$@ jours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ הקלטות · %2$@ באשפה. מחיקה לצמיתות לאחר %3$@ ימים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ रिकॉर्डिंग · %2$@ ट्रैश में। %3$@ दिनों के बाद स्थायी रूप से हट जाएँगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ snimka(e) · %2$@ u smeću. Trajno se brišu nakon %3$@ dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ felvétel · %2$@ a kukában. Végleges törlés %3$@ nap után."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ rekaman · %2$@ di sampah. Dihapus permanen setelah %3$@ hari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nota/e · %2$@ nel cestino. Rimozione definitiva dopo %3$@ giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 件の録音 · %2$@ ゴミ箱内。%3$@ 日後に完全削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 %1$@개 · %2$@ 휴지통. %3$@일 후 영구 삭제됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ rakaman · %2$@ dalam tong sampah. Dipadam kekal selepas %3$@ hari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ opptak · %2$@ i papirkurv. Slettes permanent etter %3$@ dager."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ opname(s) · %2$@ in prullenbak. Definitief verwijderd na %3$@ dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nagranie(a) · %2$@ w koszu. Trwałe usunięcie po %3$@ dniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nota(s) · %2$@ na lixeira. Removidas permanentemente após %3$@ dias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nota(s) · %2$@ no lixo. Eliminadas permanentemente após %3$@ dias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ înregistrare(ări) · %2$@ în coș. Ștergere definitivă după %3$@ zile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ запис(ей) · %2$@ в корзине. Полное удаление через %3$@ дн."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ záznam(y) · %2$@ v koši. Natrvalo odstránené po %3$@ dňoch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ inspelning(ar) · %2$@ i papperskorgen. Tas bort efter %3$@ dagar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ รายการ · %2$@ ในถังขยะ จะลบถาวรหลังครบ %3$@ วัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kayıt · %2$@ çöp kutusunda. %3$@ gün sonra kalıcı olarak silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ запис(ів) · %2$@ у кошику. Остаточне видалення через %3$@ дн."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bản ghi · %2$@ trong thùng rác. Xóa vĩnh viễn sau %3$@ ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 条录音 · 占用 %2$@。将在 %3$@ 天后永久清除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 筆錄音 · 佔用 %2$@。將在 %3$@ 天後永久清除。"
          }
        }
