    "settings.section.ai_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iPhone 15 Pro, 16, and 17 Pro Max, Apple Intelligence runs locally offline for free. On older devices like iPhone 11 Pro Max, the local switch stays disabled and you can configure a free online model (such as Groq) or local Wi-Fi server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En iPhone 15 Pro, 16 y 17 Pro Max, Apple Intelligence funciona gratis y sin internet dentro del teléfono. En modelos anteriores como iPhone 11 Pro Max, la opción local aparece deshabilitada y puedes usar una IA gratuita en línea (como Groq) o un servidor local."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No iPhone 15 Pro, 16 e 17 Pro Max, a Apple Intelligence roda localmente grátis e offline. Em aparelhos anteriores como o iPhone 11 Pro Max, a opção local fica desativada e você pode configurar uma IA gratuita online (como Groq)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "No iPhone 15 Pro, 16 e 17 Pro Max, a Apple Intelligence corre localmente grátis e offline. Em modelos anteriores como o iPhone 11 Pro Max, a opção local fica desativada e pode usar uma IA gratuita online (como Groq)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На iPhone 15 Pro, 16 и 17 Pro Max Apple Intelligence работает бесплатно и офлайн. На более старых iPhone (напр., 11 Pro Max) локальный режим отключён, но можно подключить бесплатный онлайн-ИИ (например, Groq)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 15 Pro, 16, 17 Pro Max에서는 Apple Intelligence가 무료 오프라인으로 실행됩니다. iPhone 11 Pro Max 등 이전 모델에서는 로컬 옵션이 비활성화되며 무료 온라인 AI(Groq 등)를 연결할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 15 Pro、16 和 17 Pro Max 上，Apple 智能可在本地免费离线运行。在 iPhone 11 Pro Max 等旧机型上本地开关保持禁用，可配置免费的在线模型（如 Groq）或局域网服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 15 Pro、16 與 17 Pro Max 上，Apple Intelligence 可於本機免費離線運行。在 iPhone 11 Pro Max 等舊機型上本機選項將維持停用，您可設定免費線上 AI（如 Groq）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 15 Pro、16、17 Pro Max では Apple Intelligence が無料・オフラインで動作します。iPhone 11 Pro Max など旧機種ではローカル設定が無効になり、無料のオンラインAI（Groqなど）を設定できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur iPhone 15 Pro, 16 et 17 Pro Max, Apple Intelligence fonctionne gratuitement hors ligne. Sur les modèles plus anciens comme l'iPhone 11 Pro Max, l'option locale reste désactivée et vous pouvez utiliser une IA gratuite en ligne (ex. Groq)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf iPhone 15 Pro, 16 und 17 Pro Max läuft Apple Intelligence kostenlos offline. Auf älteren Modellen wie dem iPhone 11 Pro Max bleibt die lokale Option deaktiviert; Sie können stattdessen eine kostenlose Online-KI (z. B. Groq) nutzen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su iPhone 15 Pro, 16 e 17 Pro Max, Apple Intelligence funziona gratis offline. Sui modelli precedenti come iPhone 11 Pro Max l'opzione locale resta disabilitata e puoi configurare un'IA gratuita online (come Groq)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في iPhone 15 Pro و16 و17 Pro Max يعمل Apple Intelligence محلياً ومجاناً دون إنترنت. في الأجهزة الأقدم مثل iPhone 11 Pro Max يظل الخيار المحلي معطلاً ويمكنك استخدام ذكاء اصطناعي مجاني عبر الإنترنت (مثل Groq)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 15 Pro, 16 और 17 Pro Max पर Apple Intelligence मुफ्त और ऑफलाइन चलता है। iPhone 11 Pro Max जैसे पुराने फोन पर स्थानीय विकल्प बंद रहता है और आप मुफ्त ऑनलाइन AI (जैसे Groq) जोड़ सकते हैं।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 15 Pro, 16 ve 17 Pro Max'te Apple Intelligence ücretsiz ve çevrimdışı çalışır. iPhone 11 Pro Max gibi eski cihazlarda yerel seçenek devre dışı kalır ve ücretsiz çevrimiçi yapay zeka (ör. Groq) ayarlayabilirsiniz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op iPhone 15 Pro, 16 en 17 Pro Max draait Apple Intelligence gratis offline. Op oudere modellen zoals iPhone 11 Pro Max blijft de lokale schakelaar uitgeschakeld en kun je een gratis online AI (zoals Groq) gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na iPhone 15 Pro, 16 i 17 Pro Max Apple Intelligence działa bezpłatnie offline. Na starszych modelach (np. iPhone 11 Pro Max) opcja lokalna jest wyłączona — możesz skonfigurować darmowe AI online (np. Groq)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На iPhone 15 Pro, 16 і 17 Pro Max Apple Intelligence працює безкоштовно та офлайн. На старіших моделях (напр., 11 Pro Max) локальний режим вимкнено, тож можна підключити безкоштовний онлайн-ШІ (наприклад, Groq)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di iPhone 15 Pro, 16, dan 17 Pro Max, Apple Intelligence berjalan gratis secara offline. Di perangkat lama seperti iPhone 11 Pro Max, opsi lokal dinonaktifkan dan Anda bisa memakai AI online gratis (seperti Groq)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên iPhone 15 Pro, 16 và 17 Pro Max, Apple Intelligence chạy ngoại tuyến miễn phí. Trên máy đời cũ như iPhone 11 Pro Max, tùy chọn cục bộ bị tắt và bạn có thể dùng AI trực tuyến miễn phí (như Groq)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บน iPhone 15 Pro, 16 และ 17 Pro Max Apple Intelligence ทำงานในเครื่องได้ฟรีแบบออฟไลน์ บนรุ่นเก่าเช่น iPhone 11 Pro Max ตัวเลือกในเครื่องจะปิดไว้ และใช้ AI ออนไลน์ฟรี (เช่น Groq) แทนได้"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På iPhone 15 Pro, 16 och 17 Pro Max körs Apple Intelligence gratis offline. På äldre modeller som iPhone 11 Pro Max är det lokala alternativet inaktiverat och du kan konfigurera gratis moln-AI (t.ex. Groq)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På iPhone 15 Pro, 16 og 17 Pro Max kører Apple Intelligence gratis offline. På ældre modeller som iPhone 11 Pro Max forbliver den lokale funktion deaktiveret, og du kan bruge gratis online AI (f.eks. Groq)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På iPhone 15 Pro, 16 og 17 Pro Max kjører Apple Intelligence gratis frakoblet. På eldre modeller som iPhone 11 Pro Max er det lokale valget deaktivert, og du kan bruke gratis nett-AI (f.eks. Groq)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 15 Pro, 16 ja 17 Pro Max -malleissa Apple Intelligence toimii ilmaiseksi ilman verkkoa. Vanhemmissa kuten iPhone 11 Pro Max paikallinen asetus pysyy pois käytöstä ja voit käyttää ilmaista pilvi-AI:ta (kuten Groq)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε iPhone 15 Pro, 16 και 17 Pro Max, το Apple Intelligence τρέχει δωρεάν εκτός σύνδεσης. Σε παλαιότερες συσκευές όπως iPhone 11 Pro Max παραμένει ανενεργό και μπορείτε να ρυθμίσετε δωρεάν cloud AI (όπως Groq)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב-iPhone 15 Pro, 16 ו-17 Pro Max, Apple Intelligence פועל מקומית בחינם וללא רשת. במכשירים ישנים יותר כמו iPhone 11 Pro Max האפשרות המקומית מושבתת וניתן להגדיר AI מקוון חינמי (כמו Groq)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na iPhone 15 Pro, 16 a 17 Pro Max běží Apple Intelligence zdarma offline. Na starších modelech jako iPhone 11 Pro Max zůstává místní přepínač vypnutý a můžete použít bezplatnou cloudovou AI (např. Groq)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe iPhone 15 Pro, 16 și 17 Pro Max, Apple Intelligence rulează gratuit offline. Pe modele mai vechi precum iPhone 11 Pro Max opțiunea locală rămâne dezactivată și puteți configura un AI gratuit online (ex. Groq)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 15 Pro, 16 és 17 Pro Max készüléken az Apple Intelligence ingyenesen, offline fut. Régebbi modelleken (pl. iPhone 11 Pro Max) a helyi opció inaktív marad, és ingyenes online AI (pl. Groq) állítható be."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada iPhone 15 Pro, 16 dan 17 Pro Max, Apple Intelligence berjalan secara percuma dan luar talian. Pada model lama seperti iPhone 11 Pro Max, pilihan tempatan dinyahdayakan dan anda boleh guna AI dalam talian percuma (seperti Groq)."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En iPhone 15 Pro, 16 i 17 Pro Max, Apple Intelligence funciona gratis i fora de línia. En dispositius anteriors com l'iPhone 11 Pro Max l'opció local resta inhabilitada i pots configurar una IA gratuïta en línia (com Groq)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na iPhoneu 15 Pro, 16 i 17 Pro Max Apple Intelligence radi besplatno izvan mreže. Na starijim uređajima poput iPhonea 11 Pro Max lokalna je opcija onemogućena te možete koristiti besplatni cloud AI (npr. Groq)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na iPhone 15 Pro, 16 a 17 Pro Max beží Apple Intelligence zadarmo offline. Na starších modeloch ako iPhone 11 Pro Max ostáva lokálna voľba deaktivovaná a môžete použiť bezplatnú online AI (napr. Groq)."
          }
        }
      }
    },
