    "sample2.turn1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need global search to find any keyword across all recordings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitamos que el buscador global encuentre cualquier palabra clave en todas las grabaciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisamos que a busca global encontre qualquer palavra-chave em todas as gravações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisamos que a pesquisa global encontre qualquer palavra-chave em todas as gravações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нам нужен глобальный поиск любого ключевого слова по всем записям."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 녹음에서 어떤 키워드든 찾을 수 있는 통합 검색이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们需要全局搜索功能来在所有录音中查找任意关键词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們需要全域搜尋功能來在所有錄音中尋找任何關鍵字。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての録音から任意のキーワードを見つけられるグローバル検索が必要です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nous faut une recherche globale pour trouver n'importe quel mot-clé dans tous les enregistrements."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir brauchen eine globale Suche, um jedes Schlüsselwort in allen Aufnahmen zu finden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci serve una ricerca globale per trovare qualsiasi parola chiave in tutte le registrazioni."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحتاج إلى بحث شامل للعثور على أي كلمة مفتاحية في جميع التسجيلات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमें सभी रिकॉर्डिंग में कोई भी कीवर्ड खोजने के लिए ग्लोबल सर्च चाहिए।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm kayıtlarda herhangi bir anahtar kelimeyi bulacak küresel aramaya ihtiyacımız var."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hebben een globale zoekfunctie nodig om elk trefwoord in alle opnamen te vinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebujemy globalnego wyszukiwania dowolnego słowa kluczowego we wszystkich nagraniach."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нам потрібен глобальний пошук будь-якого ключового слова в усіх записах."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kita perlu pencarian global untuk menemukan kata kunci apa pun di semua rekaman."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng ta cần tìm kiếm toàn cục để tìm bất kỳ từ khóa nào trên mọi bản ghi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราต้องการการค้นหาทั่วทั้งแอปเพื่อหาคำสำคัญในทุกไฟล์บันทึก"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi behöver global sökning för att hitta valfritt nyckelord i alla inspelningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har brug for global søgning til at finde ethvert nøgleord i alle optagelser."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi trenger globalt søk for å finne ethvert nøkkelord i alle opptak."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarvitsemme yleishaun, jolla löytyy mikä tahansa avainsana kaikista äänityksistä."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρειαζόμαστε καθολική αναζήτηση για να βρίσκουμε κάθε λέξη-κλειδί σε όλες τις εγγραφές."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנחנו צריכים חיפוש גלובלי שימצא כל מילת מפתח בכל ההקלטות."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potřebujeme globální vyhledávání, které najde jakékoli klíčové slovo ve všech nahrávkách."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Avem nevoie de căutare globală pentru a găsi orice cuvânt cheie în toate înregistrările."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Globális keresésre van szükségünk, amely minden felvételben megtalálja a kulcsszavakat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kita perlukan carian global untuk mencari sebarang kata kunci merentas semua rakaman."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessitem que el cercador global trobi qualsevol paraula clau a totes les gravacions."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trebamo globalno pretraživanje za pronalaženje ključnih riječi u svim snimkama."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebujeme globálne vyhľadávanie, ktoré nájde akékoľvek kľúčové slovo vo všetkých nahrávkach."
          }
        }
      }
    },
    "sample2.turn2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Totally agree, and tapping the word should jump to the exact second of the audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Totalmente de acuerdo, y al tocar la palabra debe saltar al segundo exacto del audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concordo totalmente, e ao tocar na palavra deve pular para o segundo exato do áudio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Concordo totalmente, e ao tocar na palavra deve saltar para o segundo exato do áudio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полностью согласен, а нажатие на слово должно сразу перематывать к нужной секунде."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전적으로 동의하며, 단어를 누르면 오디오의 정확한 초로 바로 이동해야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全同意，而且点击词语时应当立即跳转到音频的精确秒数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完全同意，而且點選字詞時應該立即跳轉到音訊的精確秒數。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同感です。単語をタップしたら音声の正確な秒数へジャンプするようにしましょう。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout à fait d'accord, et toucher le mot doit sauter à la seconde exacte de l'audio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Völlig einverstanden, und ein Tippen auf das Wort muss zur exakten Sekunde springen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Totalmente d'accordo, e toccando la parola deve saltare al secondo esatto dell'audio."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أتفق تماماً، وعند الضغط على الكلمة يجب الانتقال إلى الثانية الدقيقة من الصوت."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिल्कुल सहमत, और शब्द पर टैप करने से ऑडियो के सटीक सेकंड पर जाना चाहिए।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesinlikle katılıyorum ve kelimeye dokununca sesin tam saniyesine atlamalı."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Helemaal mee eens, en tikken op het woord moet naar de exacte seconde springen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełna zgoda, a dotknięcie słowa powinno przenosić do dokładnej sekundy dźwięku."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цілком згоден, а натискання на слово має переносити на точну секунду аудіо."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setuju sekali, dan mengetuk kata harus langsung melompat ke detik audio yang tepat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn toàn đồng ý, và chạm vào từ phải nhảy đến đúng giây tương ứng của âm thanh."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เห็นด้วยเลย และการแตะที่คำควรข้ามไปยังวินาทีที่ตรงกันของเสียงทันที"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Helt enig, och att trycka på ordet ska hoppa till den exakta sekunden i ljudet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Helt enig, og et tryk på ordet skal hoppe til det nøjagtige sekund i lyden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Helt enig, og et trykk på ordet må hoppe til det nøyaktige sekundet i lyden."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täysin samaa mieltä, ja sanan napauttamisen pitää hypätä täsmälleen oikeaan sekuntiin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συμφωνώ απόλυτα, και πατώντας τη λέξη πρέπει να μεταβαίνει στο ακριβές δευτερόλεπτο."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסכים לגמרי, ולחיצה על המילה צריכה לקפוץ לשנייה המדויקת בשמע."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naprosto souhlasím, a klepnutí na slovo musí přeskočit na přesnou sekundu zvuku."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Total de acord, iar atingerea cuvântului trebuie să sară la secunda exactă din audio."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Teljesen egyetértek, és a szóra koppintva a pontos másodpercre kell ugrania."
          }
        },
