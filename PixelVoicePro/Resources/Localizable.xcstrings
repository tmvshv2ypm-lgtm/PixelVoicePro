          "stringUnit": {
            "state": "translated",
            "value": "Für Sprachaufnahmen ist der Mikrofonzugriff erforderlich."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorizzazione del microfono è obbligatoria per registrare."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذن الميكروفون مطلوب لتسجيل الملاحظات الصوتية."
