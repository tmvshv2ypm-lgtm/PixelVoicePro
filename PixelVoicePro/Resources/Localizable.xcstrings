    "settings.section.speech_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-Device mode processes speech directly on the iPhone's Neural Engine with zero latency and complete privacy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo On-Device procesa la voz directamente en el Neural Engine del iPhone con latencia cero y privacidad total."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo On-Device processa a fala diretamente no Neural Engine do iPhone com latência zero e privacidade total."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo On-Device processa a voz diretamente no Neural Engine do iPhone com latência zero e privacidade total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальный режим (On-Device) обрабатывает речь на Neural Engine iPhone с нулевой задержкой и полной приватностью."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온디바이스 모드는 지연 없이 완전한 개인정보 보호를 유지하며 iPhone의 Neural Engine에서 직접 음성을 처리합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端侧识别模式直接在 iPhone 神经网络引擎上处理语音，零延迟且完全保护隐私。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置端辨識模式直接在 iPhone 神經網路引擎上處理語音，零延遲且完全保護隱私。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイスモードは iPhone の Neural Engine 上で直接音声を処理し、低遅延と完全なプライバシーを実現します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode sur l'appareil traite la voix directement sur le Neural Engine de l'iPhone sans latence et en toute confidentialité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der On-Device-Modus verarbeitet Sprache direkt auf der Neural Engine des iPhone ohne Latenz und mit voller Privatsphäre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità On-Device elabora la voce direttamente sul Neural Engine di iPhone con latenza zero e privacy totale."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعالج وضع الجهاز الصوت مباشرة على محرك Neural Engine في iPhone بدون تأخير وبخصوصية تامة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑन-डिवाइस मोड बिना किसी देरी और पूर्ण गोपनीयता के साथ iPhone के न्यूरल इंजन पर सीधे आवाज प्रोसेस करता है।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz içi mod, konuşmayı sıfır gecikme ve tam gizlilikle doğrudan iPhone'un Neural Engine'ında işler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De On-Device-modus verwerkt spraak direct op de Neural Engine van de iPhone met nul latentie en volledige privacy."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb na urządzeniu przetwarza mowę bezpośrednio na Neural Engine iPhone'a z zerowym opóźnieniem i pełną prywatnością."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальний режим (On-Device) обробляє мовлення безпосередньо на Neural Engine iPhone з мінімальною затримкою та повною приватністю."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode On-Device memproses ucapan langsung di Neural Engine iPhone tanpa latensi dan dengan privasi penuh."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ trên thiết bị xử lý giọng nói trực tiếp trên Neural Engine của iPhone với độ trễ bằng không và bảo mật tuyệt đối."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหมดบนอุปกรณ์ประมวลผลเสียงพูดบน Neural Engine ของ iPhone โดยตรงด้วยความหน่วงต่ำและเป็นส่วนตัวสูงสุด"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "On-Device-läget bearbetar tal direkt på iPhones Neural Engine med noll fördröjning och full integritet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "On-Device-tilstand behandler tale direkte på iPhones Neural Engine uden forsinkelse og med fuldt privatliv."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "On-Device-modus behandler tale direkte på iPhones Neural Engine uten forsinkelse og med fullt personvern."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laitteella suoritettava tila käsittelee puheen suoraan iPhonen Neural Enginellä ilman viivettä ja täydellä yksityisyydellä."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λειτουργία στη συσκευή επεξεργάζεται την ομιλία απευθείας στο Neural Engine του iPhone με μηδενική καθυστέρηση."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצב במכשיר מעבד דיבור ישירות ב-Neural Engine של ה-iPhone ללא השהיה ובפרטיות מלאה."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Režim v zařízení zpracovává řeč přímo na Neural Enginu iPhonu s nulovou latencí a úplným soukromím."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modul pe dispozitiv procesează vocea direct pe Neural Engine-ul iPhone-ului fără latență și cu confidențialitate deplină."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszközön futó mód késleltetés nélkül, teljes adatvédelemmel dolgozza fel a beszédet az iPhone Neural Engine-jén."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mod Pada Peranti memproses pertuturan terus pada Neural Engine iPhone dengan kependaman sifar dan privasi penuh."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El mode al dispositiu processa la veu directament al Neural Engine de l'iPhone amb latència zero i privadesa total."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Način na uređaju obrađuje govor izravno na iPhoneovom Neural Engineu uz nultu latenciju i potpunu privatnost."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Režim v zariadení spracúva reč priamo na Neural Engine iPhonu s nulovou latenciou a úplným súkromím."
          }
        }
      }
    },
