    "trash.confirm.delete_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف ملف الصوت والنص نهائياً ولن يمكن استعادتهما."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arxiu d’àudio i la transcripció s’eliminaran per sempre i no es podran recuperar."
          }
        },
        "cs": {
          "stringUnit": {
