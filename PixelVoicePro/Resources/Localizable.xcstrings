    "sample1.turn1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to the artificial intelligence lab applied to real-time acoustic processing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenidos al laboratorio de inteligencia artificial aplicada al procesamiento acústico en tiempo real."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindos ao laboratório de inteligência artificial aplicada ao processamento acústico em tempo real."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindos ao laboratório de inteligência artificial aplicada ao processamento acústico em tempo real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добро пожаловать в лабораторию искусственного интеллекта и обработки звука в реальном времени."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 음향 처리에 인공지능을 적용하는 연구실에 오신 것을 환영합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎来到实时声学处理人工智能实验室。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歡迎來到即時聲學處理人工智慧實驗室。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リアルタイム音響処理に応用する人工知能ラボへようこそ。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue au laboratoire d'intelligence artificielle appliquée au traitement acoustique en temps réel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen im Labor für künstliche Intelligenz in der Echtzeit-Akustikverarbeitung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Benvenuti nel laboratorio di intelligenza artificiale applicata all'elaborazione acustica in tempo reale."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحباً بكم في مختبر الذكاء الاصطناعي التطبيقي لمعالجة الصوت في الوقت الفعلي."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रियल-टाइम ध्वनि प्रसंस्करण के लिए आर्टिफिशियल इंटेलिजेंस लैब में आपका स्वागत है।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçek zamanlı akustik işleme yapay zeka laboratuvarına hoş geldiniz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welkom bij het laboratorium voor kunstmatige intelligentie en realtime akoestische verwerking."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Witamy w laboratorium sztucznej inteligencji i przetwarzania dźwięku w czasie rzeczywistym."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ласкаво просимо до лабораторії штучного інтелекту та обробки звуку в реальному часі."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selamat datang di laboratorium kecerdasan buatan untuk pemrosesan akustik real-time."
