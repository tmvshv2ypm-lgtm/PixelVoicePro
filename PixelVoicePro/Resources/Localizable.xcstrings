    "trash.empty.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ التسجيلات المحذوفة هنا لمدة 30 يوماً لتتمكن من استعادتها في أي وقت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes esborrades es guarden aquí 30 dies per poder restaurar-les quan vulguis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazané nahrávky zde zůstávají 30 dní, abyste je mohli kdykoli obnovit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slettede optagelser gemmes her i 30 dage, så du altid kan gendanne dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöschte Aufnahmen bleiben 30 Tage lang hier und können jederzeit wiederhergestellt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι διαγραμμένες εγγραφές παραμένουν εδώ για 30 ημέρες ώστε να μπορείτε να τις επαναφέρετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted recordings are kept here for 30 days so you can restore them anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas borradas se guardan aquí 30 días para que puedas restaurarlas en cualquier momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetut tallenteet säilytetään täällä 30 päivää, jotta voit palauttaa ne milloin tahansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes supprimées restent ici 30 jours afin que vous puissiez les restaurer à tout moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלטות שנמחקו נשמרות כאן למשך 30 יום כדי שתוכל לשחזר אותן בכל עת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाई गई रिकॉर्डिंग 30 दिनों तक यहाँ रखी जाती हैं ताकि आप उन्हें कभी भी पुनर्स्थापित कर सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrisane snimke čuvaju se ovdje 30 dana kako biste ih uvijek mogli vratiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A törölt felvételek 30 napig itt maradnak, így bármikor visszaállíthatod őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman yang dihapus disimpan di sini selama 30 hari agar dapat dipulihkan kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note eliminate restano qui per 30 giorni così puoi ripristinarle in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除された録音は30日間ここに保存され、いつでも復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제된 녹음은 30일간 여기에 보관되며 언제든 복원할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakaman yang dipadam disimpan di sini selama 30 hari supaya anda boleh memulihkannya bila-bila masa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slettede opptak beholdes her i 30 dager så du kan gjenopprette dem når som helst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderde opnames blijven hier 30 dagen bewaard zodat je ze altijd kunt herstellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięte nagrania są tu przechowywane przez 30 dni, aby można je było przywrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas apagadas ficam aqui por 30 dias para que você possa restaurá-las quando quiser."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas eliminadas ficam aqui por 30 dias para as poder restaurar a qualquer momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrările șterse sunt păstrate aici 30 de zile pentru a le putea restaura oricând."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалённые записи хранятся здесь 30 дней — вы можете восстановить их в любой момент."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymazané nahrávky tu zostávajú 30 dní, aby ste ich mohli kedykoľvek obnoviť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Raderade inspelningar sparas här i 30 dagar så att du kan återställa dem när som helst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกที่ถูกลบจะถูกเก็บไว้ที่นี่ 30 วัน เพื่อให้คุณกู้คืนได้ทุกเมื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silinen kayıtlar, dilediğiniz zaman geri yükleyebilmeniz için burada 30 gün saklanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалені записи зберігаються тут 30 днів, щоб ви могли будь-коли їх відновити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản ghi đã xóa được lưu tại đây 30 ngày để bạn có thể khôi phục bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除的录音会在此保留 30 天，方便随时恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已刪除的錄音會在此保留 30 天，隨時可還原。"
          }
        }
      }
    },
