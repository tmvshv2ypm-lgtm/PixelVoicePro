    "settings.ai_chat_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional for older iPhones or cloud summaries. Leave the key empty to reuse the same key from the Whisper section above (ideal for Groq)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional para iPhones anteriores o resúmenes en la nube. Si dejas la clave vacía, reutilizará automáticamente la misma clave API de la sección Whisper de arriba (ideal para usar una sola clave gratis de Groq)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional para iPhones anteriores ou resumos na nuvem. Deixe a chave vazia para reutilizar a mesma chave da seção Whisper acima (ideal para Groq)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional para iPhones anteriores ou resumos na nuvem. Deixe a chave vazia para reutilizar a mesma chave da secção Whisper acima (ideal para Groq)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно для старых iPhone или облачных сводок. Оставьте ключ пустым, чтобы использовать ключ из раздела Whisper выше (удобно для Groq)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 iPhone 또는 클라우드 요약에 선택 사항입니다. 키를 비워 두면 위 Whisper 섹션의 키를 자동으로 재사용합니다(Groq에 적합)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧款 iPhone 或云端摘要可选配置。密钥留空将自动复用上方 Whisper 栏填写的 API 密钥（适合 Groq 单密钥双用）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊款 iPhone 或雲端摘要選用設定。金鑰留空將自動共用上方 Whisper 欄的 API 金鑰（適合 Groq）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旧型iPhoneやクラウド要約用のオプションです。空欄にすると上のWhisper欄のAPIキーを自動で再利用します（Groqに最適）。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionnel pour les anciens iPhone ou résumés cloud. Laissez la clé vide pour réutiliser celle de la section Whisper ci-dessus (idéal pour Groq)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional für ältere iPhones oder Cloud-Zusammenfassungen. Leer lassen, um den Whisper-API-Schlüssel oben mitzunutzen (ideal für Groq)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Opzionale per iPhone precedenti o riassunti cloud. Lascia vuoto il campo chiave per riutilizzare la chiave Whisper sopra (ideale per Groq)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري لهواتف iPhone الأقدم. اترك المفتاح فارغاً لإعادة استخدام نفس مفتاح قسم Whisper أعلاه (مثالي لـ Groq)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुराने iPhone के लिए वैकल्पिक। ऊपर दिए गए Whisper अनुभाग की कुंजी को दोबारा उपयोग करने के लिए इसे खाली छोड़ दें (Groq के लिए उत्तम)।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski iPhone'lar veya bulut özetleri için isteğe bağlıdır. Yukarıdaki Whisper anahtarını yeniden kullanmak için boş bırakın (Groq için idealdir)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel voor oudere iPhones. Laat leeg om dezelfde sleutel uit het Whisper-gedeelte hierboven te hergebruiken (ideaal voor Groq)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne dla starszych iPhone'ów. Zostaw puste, aby ponownie użyć klucza z sekcji Whisper powyżej (idealne dla Groq)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необов'язково для старіших iPhone. Залиште порожнім, щоб повторно використати ключ із розділу Whisper вище (ідеально для Groq)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsional untuk iPhone lama. Kosongkan untuk memakai kunci yang sama dari bagian Whisper di atas (cocok untuk Groq)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn cho iPhone đời cũ. Để trống khóa để dùng lại khóa từ mục Whisper phía trên (lý tưởng cho Groq)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลือกสำหรับ iPhone รุ่นเก่า เว้นว่างเพื่อใช้คีย์เดียวกับส่วน Whisper ด้านบน (เหมาะสำหรับ Groq)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfritt för äldre iPhones. Lämna tomt för att återanvända nyckeln från Whisper-avsnittet ovan (perfekt för Groq)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfrit til ældre iPhones. Lad feltet stå tomt for at genbruge nøglen fra Whisper-afsnittet ovenfor (ideelt til Groq)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfritt for eldre iPhoner. La stå tomt for å gjenbruke nøkkelen fra Whisper-delen ovenfor (ideelt for Groq)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valinnainen vanhemmille iPhoneille. Jätä tyhjäksi käyttääksesi ylemmän Whisper-osion avainta (ihanteellinen Groqille)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προαιρετικό για παλαιότερα iPhone. Αφήστε κενό για επαναχρησιμοποίηση του κλειδιού Whisper παραπάνω."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אופציונלי עבור מכשירי iPhone ישנים. השאר ריק כדי להשתמש שוב באותו מפתח מהגדרות Whisper למעלה (אידיאלי ל-Groq)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volitelné pro starší iPhony. Ponechte prázdné pro znovupoužití klíče ze sekce Whisper výše (ideální pro Groq)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțional pentru iPhone-uri mai vechi. Lăsați gol pentru a reutiliza cheia din secțiunea Whisper de mai sus (ideal pentru Groq)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Régebbi iPhone-okhoz opcionális. Hagyja üresen a fenti Whisper kulcs újrafelhasználásához (Groq-hoz ideális)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan untuk iPhone lama. Biarkan kosong untuk guna semula kunci dari bahagian Whisper di atas (sesuai untuk Groq)."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional per a iPhones anteriors. Deixa la clau buida per reutilitzar la de la secció Whisper superior (ideal per a Groq)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcionalno za starije iPhone uređaje. Ostavite prazno za ponovnu upotrebu ključa iz gornjeg Whisper odjeljka."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Voliteľné pre staršie iPhony. Nechajte prázdne na opätovné použitie kľúča zo sekcie Whisper vyššie (ideálne pre Groq)."
          }
        }
      }
    },
