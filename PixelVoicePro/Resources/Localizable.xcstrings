    "ai.error.no_transcript": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This recording has no transcribed words yet. Re-analyze the audio first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta grabación aún no tiene palabras transcritas. Re-analiza el audio primero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta gravação ainda não tem palavras transcritas. Reanalise o áudio primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta gravação ainda não tem palavras transcritas. Reanalise o áudio primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой записи пока нет транскрибированных слов. Сначала повторно проанализируйте аудио."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 녹음에는 아직 받아쓴 단어가 없습니다. 먼저 오디오를 다시 분석하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此录音尚无转录文字。请先重新分析音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此錄音尚無轉錄文字。請先重新分析音訊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この録音にはまだ文字起こしがありません。先に音声を再解析してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistrement n'a pas encore de texte transcrit. Réanalysez l'audio d'abord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufnahme hat noch keinen transkribierten Text. Analysieren Sie zuerst das Audio neu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa registrazione non ha ancora parole trascritte. Rianalizza prima l'audio."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي هذا التسجيل على كلمات منسوخة بعد. أعد تحليل الصوت أولاً."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रिकॉर्डिंग में अभी तक कोई लिखित शब्द नहीं हैं। पहले ऑडियो का पुनः विश्लेषण करें।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kayıtta henüz metne dökülmüş kelime yok. Önce sesi yeniden analiz edin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze opname heeft nog geen getranscribeerde woorden. Analyseer eerst de audio opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nagranie nie ma jeszcze transkrypcji. Najpierw ponownie przeanalizuj dźwięk."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цьому записі ще немає транскрибованих слів. Спочатку переаналізуйте аудіо."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman ini belum memiliki kata yang ditranskripsi. Analisis ulang audio terlebih dahulu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi này chưa có từ nào được chép lời. Hãy phân tích lại âm thanh trước."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกนี้ยังไม่มีคำที่ถอดเสียง กรุณาวิเคราะห์เสียงซ้ำก่อน"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här inspelningen har inga transkriberade ord ännu. Analysera om ljudet först."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne optagelse har ingen transskriberede ord endnu. Genanalyser lyden først."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette opptaket har ingen transkriberte ord ennå. Analyser lyden på nytt først."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä tallenteessa ei ole vielä litteroituja sanoja. Analysoi ääni ensin uudelleen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η εγγραφή δεν έχει ακόμη απομαγνητοφωνημένες λέξεις. Αναλύστε ξανά τον ήχο πρώτα."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להקלטה זו אין עדיין מילים מתומללות. נתח מחדש את השמע תחילה."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato nahrávka zatím neobsahuje přepsaná slova. Nejprve znovu analyzujte audio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această înregistrare nu are încă cuvinte transcrise. Reanalizați mai întâi sunetul."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a felvétel még nem tartalmaz átírt szavakat. Előbb elemezze újra a hangot."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
