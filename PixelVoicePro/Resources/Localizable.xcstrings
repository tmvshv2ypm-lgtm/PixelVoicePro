          "stringUnit": {
            "state": "translated",
            "value": "曖昧な相対日付は使用禁止"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne jamais utiliser de dates relatives ambiguës"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine mehrdeutigen relativen Daten verwenden"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai usare date relative ambigue"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدم استخدام تواريخ نسبية غامضة أبداً"
