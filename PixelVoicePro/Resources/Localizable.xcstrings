    "settings.section.whisper_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can connect the official OpenAI Whisper API or a local Whisper server on your network to refine word-by-word timestamps after each recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes conectar la API oficial de OpenAI Whisper o un servidor Whisper local en tu red para refinar las marcas de tiempo palabra por palabra al finalizar cada grabación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode conectar a API oficial do OpenAI Whisper ou um servidor Whisper local na sua rede para refinar os tempos palavra por palavra após cada gravação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ligar a API oficial da OpenAI Whisper ou um servidor Whisper local na sua rede para refinar as marcas de tempo palavra a palavra após cada gravação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете подключить официальный API OpenAI Whisper или локальный сервер Whisper для точной пословной разметки после каждой записи."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 완료 후 단어별 타임스탬프를 정교하게 다듬기 위해 공식 OpenAI Whisper API 또는 로컬 네트워크의 Whisper 서버를 연결할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以连接官方 OpenAI Whisper API 或局域网内的本地 Whisper 服务器，在每次录音结束后精修逐词时间戳。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以連接官方 OpenAI Whisper API 或區域網路內的本地 Whisper 伺服器，在每次錄音結束後精修逐字時間戳記。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音終了後に単語単位のタイムスタンプを精緻化するため、公式 OpenAI Whisper API やローカルネットワーク上の Whisper サーバーを接続できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez connecter l'API officielle OpenAI Whisper ou un serveur Whisper local sur votre réseau pour affiner les horodatages mot par mot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können die offizielle OpenAI Whisper API oder einen lokalen Whisper-Server verbinden, um Wort-für-Wort-Zeitstempel nach jeder Aufnahme zu verfeinern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi collegare l'API ufficiale OpenAI Whisper o un server Whisper locale per perfezionare i timestamp parola per parola al termine della registrazione."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك ربط واجهة OpenAI Whisper الرسمية أو خادم Whisper محلي لتحسين التوقيت كلمة بكلمة بعد كل تسجيل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक रिकॉर्डिंग के बाद शब्द-दर-शब्द टाइमस्टैम्प सुधारने के लिए आप आधिकारिक OpenAI Whisper API या स्थानीय Whisper सर्वर कनेक्ट कर सकते हैं।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her kayıttan sonra kelime bazlı zaman damgalarını iyileştirmek için resmi OpenAI Whisper API'sini veya yerel bir Whisper sunucusunu bağlayabilirsiniz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt de officiële OpenAI Whisper API of een lokale Whisper-server koppelen om woord-voor-woord tijdstempels na elke opname te verfijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz podłączyć oficjalne API OpenAI Whisper lub lokalny serwer Whisper, aby doprecyzować znaczniki czasu słowo po słowie po nagraniu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете підключити офіційний API OpenAI Whisper або локальний сервер Whisper у мережі для точного пословного розпізнавання після запису."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat menghubungkan API OpenAI Whisper resmi atau server Whisper lokal di jaringan Anda untuk menyempurnakan timestamp kata demi kata."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể kết nối API OpenAI Whisper chính thức hoặc máy chủ Whisper cục bộ để tinh chỉnh mốc thời gian từng từ sau khi ghi âm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถเชื่อมต่อ OpenAI Whisper API อย่างเป็นทางการหรือเซิร์ฟเวอร์ Whisper ในเครือข่ายเพื่อปรับเวลาของแต่ละคำให้แม่นยำขึ้นหลังบันทึกเสร็จ"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ansluta det officiella OpenAI Whisper API:t eller en lokal Whisper-server för att förfina tidsstämplar ord för ord efter varje inspelning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan tilslutte den officielle OpenAI Whisper API eller en lokal Whisper-server for at finjustere tidsstempler ord for ord efter hver optagelse."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan koble til den offisielle OpenAI Whisper-API-en eller en lokal Whisper-server for å finjustere tidsstempler ord for ord etter hvert opptak."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit yhdistää virallisen OpenAI Whisper API:n tai paikallisen Whisper-palvelimen tarkentaaksesi sanakohtaisia aikaleimoja äänityksen jälkeen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να συνδέσετε το επίσημο OpenAI Whisper API ή έναν τοπικό διακομιστή Whisper για ακριβέστερες χρονικές σημάνσεις."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לחבר את ה-API הרשמי של OpenAI Whisper או שרת Whisper מקומי לשיפור תזמון המילים לאחר כל הקלטה."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete připojit oficiální OpenAI Whisper API nebo lokální server Whisper pro zpřesnění časových značek slovo po slovu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți conecta API-ul oficial OpenAI Whisper sau un server Whisper local pentru a rafina marcajele temporale cuvânt cu cuvânt."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakoztathatod a hivatalos OpenAI Whisper API-t vagy egy helyi Whisper szervert a szavankénti időbélyegek finomításához."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menyambungkan API OpenAI Whisper rasmi atau pelayan Whisper tempatan untuk memperhalusi cap masa perkataan demi perkataan."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots connectar l'API oficial d'OpenAI Whisper o un servidor Whisper local per refinar les marques de temps paraula per paraula."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete povezati službeni OpenAI Whisper API ili lokalni Whisper poslužitelj za preciznije vremenske oznake nakon snimanja."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžete pripojiť oficiálne OpenAI Whisper API alebo lokálny server Whisper na spresnenie časových značiek slovo po slove."
          }
        }
      }
    },
