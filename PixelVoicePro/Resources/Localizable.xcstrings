          "stringUnit": {
            "state": "translated",
            "value": "此裝置不支援裝置端 Apple Intelligence。請在設定中加入免費 Groq API 金鑰以使用雲端優化。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末はローカルの Apple Intelligence に非対応です。設定で無料の Groq API キーを追加してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence local non pris en charge ici. Ajoutez une clé API Groq gratuite dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokales Apple Intelligence wird nicht unterstützt. Fügen Sie in den Einstellungen einen kostenlosen Groq-API-Schlüssel hinzu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence locale non supportato su questo dispositivo. Aggiungi una chiave gratuita Groq nelle Impostazioni."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الذكاء المحلي غير مدعوم على هذا الجهاز. أضف مفتاح Groq المجاني في الإعدادات لاستخدام السحابة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर स्थानीय Apple Intelligence समर्थित नहीं है। क्लाउड के लिए सेटिंग्स में मुफ्त Groq API कुंजी जोड़ें।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz yerel Apple Intelligence'ı desteklemiyor. Bulut için Ayarlar'dan ücretsiz Groq API anahtarı ekleyin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Apple Intelligence wordt niet ondersteund. Voeg een gratis Groq API-sleutel toe bij Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalne Apple Intelligence nie jest obsługiwane. Dodaj darmowy klucz API Groq w Ustawieniach."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальний Apple Intelligence не підтримується. Додайте безкоштовний ключ Groq у Налаштуваннях."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence lokal tidak didukung di perangkat ini. Tambahkan kunci API Groq gratis di Pengaturan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị không hỗ trợ Apple Intelligence cục bộ. Thêm khóa Groq API miễn phí trong Cài đặt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์นี้ไม่รองรับ Apple Intelligence ในเครื่อง โปรดเพิ่มคีย์ Groq API ฟรีในการตั้งค่า"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal Apple Intelligence stöds inte på den här enheten. Lägg till en gratis Groq API-nyckel i Inställningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal Apple Intelligence understøttes ikke. Tilføj en gratis Groq API-nøgle under Indstillinger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal Apple Intelligence støttes ikke på denne enheten. Legg til en gratis Groq API-nøkkel i Innstillinger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikallinen Apple Intelligence ei ole tuettu. Lisää ilmainen Groq API-avain Asetuksissa."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το τοπικό Apple Intelligence δεν υποστηρίζεται. Προσθέστε δωρεάν κλειδί Groq API στις Ρυθμίσεις."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence מקומי אינו נתמך במכשיר זה. הוסף מפתח Groq חינמי בהגדרות."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místní Apple Intelligence není podporováno. Přidejte bezplatný klíč Groq v Nastavení."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence local nu este suportat pe acest dispozitiv. Adăugați o cheie gratuită Groq în Configurări."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyi Apple Intelligence nem támogatott. Adjon meg egy ingyenes Groq API-kulcsot a Beállításokban."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence tempatan tidak disokong. Tambah kunci API Groq percuma dalam Tetapan."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest dispositiu no admet Apple Intelligence local. Afegeix una clau gratuïta de Groq als Ajustaments."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalni Apple Intelligence nije podržan na ovom uređaju. Dodajte besplatni Groq API ključ u Postavkama."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokálne Apple Intelligence nie je podporované. Pridajte bezplatný kľúč Groq v Nastaveniach."
          }
        }
      }
    },
