    "speakers.instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace \"Speaker 1\", \"Speaker 2\", etc. with each person's real name. The name and color will instantly update across all transcript paragraphs, statistics, and exports."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia \"Locutor 1\", \"Locutor 2\", etc. por el nombre real de cada persona. El nombre y color se actualizarán al instante en todos los párrafos de la transcripción, estadísticas y exportaciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitua \"Falante 1\", \"Falante 2\", etc. pelo nome real de cada pessoa. O nome e a cor serão atualizados na hora em toda a transcrição, estatísticas e exportações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitua \"Orador 1\", \"Orador 2\", etc. pelo nome real de cada pessoa. O nome e a cor serão atualizados de imediato em toda a transcrição, estatísticas e exportações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замените «Спикер 1», «Спикер 2» и т. д. на реальные имена. Имя и цвет сразу обновятся во всех абзацах, статистике и экспорте."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"화자 1\", \"화자 2\" 등을 실제 이름으로 변경하세요. 이름과 색상이 모든 받아쓰기 문단, 통계 및 내보내기 파일에 즉시 반영됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将“说话人 1”、“说话人 2”等替换为实际姓名。名称和颜色将立即更新到所有转录段落、统计数据和导出文件中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將「說話者 1」、「說話者 2」等替換為真實姓名。名稱與顏色將立即更新至所有轉錄段落、統計與匯出檔案中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「話者 1」「話者 2」などを実際の名前に変更します。名前と色は文字起こし全体、統計、書き出しファイルに即座に反映されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacez « Intervenant 1 », « Intervenant 2 », etc. par le vrai nom de chaque personne. Le nom et la couleur seront mis à jour partout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzen Sie „Sprecher 1“, „Sprecher 2“ usw. durch echte Namen. Name und Farbe werden sofort in Transkript, Statistik und Exporten aktualisiert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisci \"Parlante 1\", \"Parlante 2\", ecc. con il nome reale di ogni persona. Nome e colore si aggiorneranno ovunque."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استبدل \"المتحدث 1\" و\"المتحدث 2\" بالاسم الحقيقي لكل شخص. سيتم تحديث الاسم واللون فوراً في كل الفقرات والإحصائيات والتصدير."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"वक्ता 1\", \"वक्ता 2\" आदि को प्रत्येक व्यक्ति के वास्तविक नाम से बदलें। नाम और रंग सभी ट्रांसक्रिप्ट, आंकड़ों और निर्यात में तुरंत अपडेट हो जाएंगे।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Konuşmacı 1\", \"Konuşmacı 2\" vb. ifadeleri gerçek isimlerle değiştirin. Ad ve renk tüm metin, istatistik ve dışa aktarımlarda anında güncellenir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervang \"Spreker 1\", \"Spreker 2\", enz. door de echte naam van elke persoon. Naam en kleur worden direct overal bijgewerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastąp „Mówca 1”, „Mówca 2” itd. prawdziwymi imionami. Nazwa i kolor zaktualizują się natychmiast w transkrypcji, statystykach i eksporcie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замініть «Спікер 1», «Спікер 2» тощо на справжні імена. Ім'я та колір миттєво оновляться в усьому тексті, статистиці та експорті."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti \"Pembicara 1\", \"Pembicara 2\", dll. dengan nama asli setiap orang. Nama dan warna akan langsung diperbarui di seluruh transkrip dan ekspor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay \"Người nói 1\", \"Người nói 2\", v.v. bằng tên thật của từng người. Tên và màu sẽ cập nhật ngay trên toàn bộ bản chép lời và tệp xuất."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยน \"ผู้พูด 1\", \"ผู้พูด 2\" ฯลฯ เป็นชื่อจริงของแต่ละคน ชื่อและสีจะอัปเดตทันทีในบทถอดเสียง สถิติ และไฟล์ส่งออกทั้งหมด"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersätt \"Talare 1\", \"Talare 2\" osv. med varje persons riktiga namn. Namn och färg uppdateras direkt i hela transkriptet och exporter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstat \"Taler 1\", \"Taler 2\" osv. med hver persons rigtige navn. Navn og farve opdateres straks overalt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstatt «Taler 1», «Taler 2» osv. med hver persons ekte navn. Navn og farge oppdateres umiddelbart overalt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korvaa \"Puhuja 1\", \"Puhuja 2\" jne. henkilöiden oikeilla nimillä. Nimi ja väri päivittyvät heti kaikkialle."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντικαταστήστε τα \"Ομιλητής 1\", \"Ομιλητής 2\" κ.λπ. με τα πραγματικά ονόματα. Το όνομα και το χρώμα θα ενημερωθούν παντού."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלף את \"דובר 1\", \"דובר 2\" וכו' בשם האמיתי של כל אדם. השם והצבע יתעדכנו מיד בכל התמלול, הסטטיסטיקות והייצוא."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahraďte „Mluvčí 1“, „Mluvčí 2“ atd. skutečnými jmény. Jméno a barva se okamžitě aktualizují v celém přepisu, statistikách i exportech."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înlocuiește „Vorbitor 1”, „Vorbitor 2” etc. cu numele real al fiecărei persoane. Numele și culoarea se vor actualiza instantaneu peste tot."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Cseréld ki a „Beszélő 1”, „Beszélő 2” stb. neveket a valódi nevekre. A név és a szín azonnal frissül mindenhol."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gantikan \"Penutur 1\", \"Penutur 2\", dsb. dengan nama sebenar setiap orang. Nama dan warna akan dikemas kini serta-merta di mana-mana."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitueix \"Locutor 1\", \"Locutor 2\", etc. pel nom real de cada persona. El nom i el color s'actualitzaran a tota la transcripció i exportacions."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamijenite \"Govornik 1\", \"Govornik 2\" itd. stvarnim imenima. Ime i boja odmah će se ažurirati u cijelom prijepisu, statistici i izvozu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahraďte „Hovoriaci 1“, „Hovoriaci 2“ atď. skutočnými menami. Meno a farba sa okamžite aktualizujú v celom prepise, štatistikách aj exportoch."
          }
        }
      }
    },
