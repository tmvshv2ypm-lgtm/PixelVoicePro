    "sample1.turn2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Professor, can the model separate voices and detect laughter during an interview?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Profesor, ¿el modelo puede separar voces y detectar risas durante una entrevista?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Professor, o modelo consegue separar vozes e detectar risos durante uma entrevista?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Professor, o modelo consegue separar vozes e detetar risos durante uma entrevista?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профессор, модель умеет разделять голоса и распознавать смех во время интервью?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "교수님, 이 모델은 인터뷰 중에 화자 목소리를 분리하고 웃음소리도 감지할 수 있나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "教授，这个模型能在访谈中区分不同说话人并检测笑声吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "教授，這個模型能在訪談中區分不同說話者並偵測笑聲嗎？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先生、このモデルはインタビュー中の話者の声を分離し、笑い声も検出できますか？"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Professeur, le modèle peut-il séparer les voix et détecter les rires pendant un entretien ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Professor, kann das Modell Stimmen trennen und Lachen während eines Interviews erkennen?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Professore, il modello può separare le voci e rilevare le risate durante un'intervista?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أستاذ، هل يستطيع النموذج فصل الأصوات واكتشاف الضحك أثناء المقابلة؟"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफेसर, क्या मॉडल इंटरव्यू के दौरान आवाज़ों को अलग कर सकता है और हंसी पहचान सकता है?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profesör, model röportaj sırasında sesleri ayırıp kahkahaları algılayabilir mi?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Professor, kan het model stemmen scheiden en gelach detecteren tijdens een interview?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profesorze, czy model potrafi rozdzielać głosy i wykrywać śmiech podczas wywiadu?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Професоре, чи може модель розділяти голоси та виявляти сміх під час інтерв'ю?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profesor, bisakah model memisahkan suara dan mendeteksi tawa saat wawancara?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thưa giáo sư, mô hình có thể tách giọng nói và phát hiện tiếng cười khi phỏng vấn không?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาจารย์ครับ โมเดลนี้สามารถแยกเสียงพูดและตรวจจับเสียงหัวเราะระหว่างสัมภาษณ์ได้ไหมครับ?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Professor, kan modellen separera röster och upptäcka skratt under en intervju?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Professor, kan modellen adskille stemmer og registrere latter under et interview?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Professor, kan modellen skille stemmer og oppdage latter under et intervju?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Professori, osaako malli erotella äänet ja tunnistaa naurun haastattelun aikana?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καθηγητά, μπορεί το μοντέλο να ξεχωρίσει φωνές και να εντοπίσει γέλια σε μια συνέντευξη;"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פרופסור, האם המודל יודע להפריד קולות ולזהות צחוק במהלך ראיון?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Profesore, dokáže model oddělit hlasy a rozpoznat smích během rozhovoru?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Profesore, poate modelul să separe vocile și să detecteze râsetele într-un interviu?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Professzor úr, a modell képes elkülöníteni a hangokat és felismerni a nevetést interjú közben?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Profesor, bolehkah model ini mengasingkan suara dan mengesan ketawa semasa temu bual?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Professor, el model pot separar veus i detectar rialles durant una entrevista?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profesore, može li model razdvojiti glasove i prepoznati smijeh tijekom intervjua?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pán profesor, dokáže model oddeliť hlasy a rozpoznať smiech počas rozhovoru?"
          }
        }
      }
    },
    "sample1.turn3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exactly, we combine SoundAnalysis with spectral diarization to index every second with absolute precision."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exactamente, combinamos SoundAnalysis con diarización espectral para indexar cada segundo con precisión absoluta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exatamente, combinamos SoundAnalysis com diarização espectral para indexar cada segundo com precisão absoluta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Exatamente, combinamos SoundAnalysis com diarização espetral para indexar cada segundo com precisão absoluta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Именно так, мы объединяем SoundAnalysis со спектральной диаризацией, чтобы точно индексировать каждую секунду."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맞습니다. SoundAnalysis와 스펙트럼 화자 분리를 결합해 매초를 완벽하게 인덱싱합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没错，我们将 SoundAnalysis 与频谱说话人分离结合起来，精确索引每一秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒錯，我們將 SoundAnalysis 與頻譜說話者分離結合起來，精確索引每一秒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その通りです。SoundAnalysis とスペクトル話者分離を組み合わせ、毎秒を正確にインデックス化します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exactement, nous combinons SoundAnalysis et diarisation spectrale pour indexer chaque seconde avec précision."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genau, wir kombinieren SoundAnalysis mit spektraler Diarisierung, um jede Sekunde präzise zu indexieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esatto, combiniamo SoundAnalysis con la diarizzazione spettrale per indicizzare ogni secondo con precisione."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بالضبط، نجمع بين SoundAnalysis وفصل المتحدثين الطيفي لفهرسة كل ثانية بدقة تامة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिल्कुल, हम हर सेकंड को सटीकता से इंडेक्स करने के लिए SoundAnalysis और स्पेक्ट्रल डाइराइज़ेशन को मिलाते हैं।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesinlikle, her saniyeyi hassas biçimde dizinlemek için SoundAnalysis ile spektral ayrıştırmayı birleştiriyoruz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Precies, we combineren SoundAnalysis met spectrale diarisatie om elke seconde nauwkeurig te indexeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokładnie tak, łączymy SoundAnalysis z diaryzacją spektralną, aby precyzyjnie indeksować każdą sekundę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Саме так, ми поєднуємо SoundAnalysis зі спектральною діаризацією для точного індексування кожної секунди."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tepat sekali, kami menggabungkan SoundAnalysis dengan diarisasi spektral untuk mengindeks setiap detik secara presisi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chính xác, chúng tôi kết hợp SoundAnalysis với phân tách phổ giọng để lập chỉ mục từng giây chính xác tuyệt đối."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถูกต้อง เราผสาน SoundAnalysis กับการแยกผู้พูดเชิงสเปกตรัมเพื่อจัดดัชนีทุกวินาทีอย่างแม่นยำ"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Exakt, vi kombinerar SoundAnalysis med spektral diarisering för att indexera varje sekund med full precision."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Præcis, vi kombinerer SoundAnalysis med spektral diarisering for at indeksere hvert sekund præcist."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettopp, vi kombinerer SoundAnalysis med spektral diarisering for å indeksere hvert sekund nøyaktig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Juuri niin, yhdistämme SoundAnalysisin ja spektrisen puhujaeroittelun jokaisen sekunnin tarkkaan indeksointiin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακριβώς, συνδυάζουμε το SoundAnalysis με φασματικό διαχωρισμό ομιλητών για απόλυτη ακρίβεια."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדיוק, אנו משלבים SoundAnalysis עם הפרדת דוברים ספקטרלית כדי למדוד כל שנייה בדיוק מוחלט."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přesně tak, kombinujeme SoundAnalysis se spektrální diarizací pro naprosto přesné indexování každé sekundy."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact, combinăm SoundAnalysis cu diarizarea spectrală pentru a indexa fiecare secundă cu precizie absolută."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontosan, a SoundAnalysis és a spektrális szétválasztás ötvözésével minden másodpercet pontosan indexelünk."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tepat sekali, kami menggabungkan SoundAnalysis dengan diarisasi spektrum untuk mengindeks setiap saat dengan tepat."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Exactament, combinem SoundAnalysis amb diarització espectral per indexar cada segon amb precisió absoluta."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravo tako, kombiniramo SoundAnalysis sa spektralnom diarizacijom za precizno indeksiranje svake sekunde."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Presne tak, kombinujeme SoundAnalysis so spektrálnou diarizáciou na presné indexovanie každej sekundy."
          }
        }
      }
    },
