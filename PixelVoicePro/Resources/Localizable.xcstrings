        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalne Apple Intelligence nie jest obsługiwane na tym sprzęcie. Wybierz Automatycznie lub AI Online."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
