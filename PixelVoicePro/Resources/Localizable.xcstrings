    "ai.summary.empty_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No AI summary yet. Tap \"AI Refine\" to polish punctuation or generate a structured summary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay resumen IA. Toca \"Refinar IA\" para pulir la puntuación, re-escanear risas/suspiros o generar un resumen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem resumo IA ainda. Toque em \"Refinar IA\" para polir a pontuação ou gerar um resumo estruturado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem resumo IA. Toque em \"Refinar IA\" para polir a pontuação ou gerar um resumo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ-резюме пока нет. Нажмите «ИИ-обработка», чтобы исправить пунктуацию или создать краткое содержание."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 AI 요약이 없습니다. \"AI 다듬기\"를 눌러 문장을 정돈하거나 요약을 생성하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无 AI 摘要。点击“AI 润色”可优化标点或生成结构化摘要。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無 AI 摘要。點擊「AI 優化」可修飾標點或產生結構化摘要。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 要約はまだありません。「AI 仕上げ」をタップして文章の整形や要約を生成できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun résumé IA pour l'instant. Touchez « Affiner IA » pour corriger ou résumer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine KI-Zusammenfassung. Tippen Sie auf „KI-Verfeinerung“, um Text zu glätten oder zusammenzufassen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun riassunto IA ancora. Tocca \"Rifinisci IA\" per migliorare la punteggiatura o creare un riassunto."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد ملخص ذكاء اصطناعي بعد. اضغط على \"تحسين بالذكاء\" لتنسيق النص أو إنشاء ملخص."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई AI सारांश नहीं है। टेक्स्ट सुधारने या सारांश बनाने के लिए \"AI सुधार\" पर टैप करें।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz yapay zeka özeti yok. Noktalamayı düzeltmek veya özet çıkarmak için \"YZ Düzelt\"e dokunun."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen AI-samenvatting. Tik op 'AI-verfijning' om tekst te verbeteren of samen te vatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak podsumowania AI. Dotknij „Popraw AI”, aby poprawić interpunkcję lub utworzyć podsumowanie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще немає ШІ-резюме. Натисніть «ШІ-обробка», щоб відшліфувати текст або створити підсумок."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada ringkasan AI. Ketuk \"Perhalus AI\" untuk merapikan teks atau membuat ringkasan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có tóm tắt AI. Chạm \"Tinh chỉnh AI\" để sửa dấu câu hoặc tạo tóm tắt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีสรุปจาก AI แตะ \"ปรับแต่งด้วย AI\" เพื่อเกลากระบวนความหรือสร้างบทสรุป"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen AI-sammanfattning än. Tryck på \"AI-förbättring\" för att finslipa texten eller skapa en sammanfattning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet AI-resumé endnu. Tryk på \"AI-forbedring\" for at finpudse tekst eller oprette resumé."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen AI-oppsummering ennå. Trykk på «AI-forbedring» for å finpusse eller oppsummere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä AI-yhteenvetoa. Napauta \"AI-viimeistely\" korjataksesi tekstiä tai luodaksesi yhteenvedon."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει ακόμη σύνοψη ΤΝ. Πατήστε «Βελτίωση ΤΝ» για βελτίωση ή σύνοψη."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין סיכום AI. הקש על \"שיפור AI\" כדי ללטש סימני פיסוק או ליצור סיכום."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím bez AI shrnutí. Klepnutím na „Upravit AI“ vylepšíte text nebo vytvoříte shrnutí."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu există un rezumat AI. Atingeți „Rafinare AI” pentru a corecta textul sau a genera un rezumat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs AI összefoglaló. Koppintson az „AI finomítás” gombra a javításhoz vagy összegzéshez."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada ringkasan AI. Ketik \"Halusi AI\" untuk perkemas tanda baca atau jana ringkasan."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha resum IA. Toca «Refinar IA» per polir o generar un resum."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema AI sažetka. Dodirnite „AI obrada” za dotjerivanje teksta ili izradu sažetka."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ bez AI zhrnutia. Ťuknutím na „Upraviť AI“ vylepšíte text alebo vytvoríte zhrnutie."
          }
        }
      }
    },
