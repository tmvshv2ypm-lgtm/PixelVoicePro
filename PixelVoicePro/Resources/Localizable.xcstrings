        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ऑडियो फ़ाइल और इसका ट्रांसक्रिप्ट स्थायी रूप से हट जाएगा और वापस नहीं मिलेगा।"
