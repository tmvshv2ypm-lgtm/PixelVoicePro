        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस हार्डवेयर पर ऑन-डिवाइस Apple Intelligence समर्थित नहीं है। सेटिंग्स में स्वचालित या ऑनलाइन AI चुनें।"
