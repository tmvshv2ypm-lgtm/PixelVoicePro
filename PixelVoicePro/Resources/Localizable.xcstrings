    "settings.section.acoustic_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust how easily laughter, sighs, coughs, and long pauses are detected. Higher sensitivity captures softer reactions and lets you re-scan existing notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta con qué facilidad se detectan risas, suspiros, tos y pausas largas. Una sensibilidad mayor capta reacciones más suaves y te permite re-escanear notas ya grabadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste com que facilidade risadas, suspiros, tosse e pausas longas são detectados. Maior sensibilidade capta reações mais suaves e permite reanalisar notas existentes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste a facilidade com que risos, suspiros, tosse e pausas longas são detetados. Maior sensibilidade capta reações mais suaves e permite reanalisar notas existentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте чувствительность распознавания смеха, вздохов, кашля и длинных пауз. Повышенная чувствительность улавливает тихие реакции и позволяет пересканировать записи."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웃음, 한숨, 기침 및 긴 침묵이 감지되는 민감도를 조정합니다. 감도를 높이면 작은 반응도 포착하며 기존 메모를 다시 분석할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整检测笑声、叹息、咳嗽和长停顿的灵敏度。更高的灵敏度可以捕捉轻柔反应，并支持重新扫描已有录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整偵測笑聲、嘆息、咳嗽與長停頓的靈敏度。較高靈敏度可捕捉較輕微的反應，並支援重新掃描現有錄音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "笑い声、ため息、咳、長い無音の検出しやすさを調整します。感度を上げると小さな反応も拾い、保存済みノートの再スキャンが可能になります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez la sensibilité de détection des rires, soupirs, toux et longues pauses. Une sensibilité élevée capte les réactions douces et permet de réanalyser vos notes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie an, wie leicht Lachen, Seufzen, Husten und lange Pausen erkannt werden. Höhere Empfindlichkeit erfasst leisere Reaktionen und ermöglicht erneutes Scannen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola la facilità di rilevamento di risate, sospiri, tosse e pause lunghe. Una sensibilità maggiore cattura reazioni più lievi e consente di rianalizzare le note."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط سهولة اكتشاف الضحك والتنهدات والسعال والوقفات الطويلة. تلتقط الحساسية الأعلى ردود الفعل الهادئة وتتيح إعادة فحص الملاحظات الحالية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हंसी, आह, खांसी और लंबे विराम पहचानने की संवेदनशीलता बदलें। अधिक संवेदनशीलता धीमी प्रतिक्रियाएं पकड़ती है और पुराने नोट्स को दोबारा स्कैन करने देती है।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kahkaha, iç çekme, öksürük ve uzun duraklamaların algılanma kolaylığını ayarlayın. Yüksek hassasiyet daha hafif tepkileri yakalar ve mevcut notları yeniden taramanızı sağlar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel in hoe snel lachen, zuchten, hoesten en lange pauzes worden herkend. Hogere gevoeligheid vangt zachtere reacties op en laat je notities opnieuw scannen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosuj czułość wykrywania śmiechu, westchnień, kaszlu i długich przerw. Wyższa czułość rejestruje cichsze reakcje i pozwala ponownie przeskanować nagrania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте чутливість розпізнавання сміху, зітхань, кашлю та довгих пауз. Вища чутливість вловлює тихі реакції та дозволяє повторно сканувати записи."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur seberapa mudah tawa, helaan napas, batuk, dan jeda panjang terdeteksi. Sensitivitas tinggi menangkap reaksi pelan dan memungkinkan pemindaian ulang catatan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều chỉnh mức độ phát hiện tiếng cười, tiếng thở dài, ho và khoảng lặng dài. Độ nhạy cao giúp bắt trọn âm thanh nhẹ và quét lại ghi chú cũ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับความไวในการตรวจจับเสียงหัวเราะ ถอนหายใจ ไอ และการเว้นช่วงยาว ความไวที่สูงขึ้นช่วยจับเสียงเบาๆ และสแกนบันทึกเดิมซ้ำได้"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Justera hur lätt skratt, suckar, hosta och långa pauser upptäcks. Högre känslighet fångar svagare reaktioner och låter dig skanna om befintliga anteckningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Juster hvor nemt latter, suk, hoste og lange pauser registreres. Højere følsomhed opfanger svagere reaktioner og lader dig genscanne eksisterende noter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Juster hvor lett latter, sukk, hoste og lange pauser oppdages. Høyere følsomhet fanger svakere reaksjoner og lar deg skanne eksisterende notater på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säädä naurun, huokausten, yskän ja pitkien taukojen tunnistusherkkyyttä. Suurempi herkkyys tallentaa hiljaisemmat reaktiot ja sallii uudelleenskannauksen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ρυθμίστε πόσο εύκολα εντοπίζονται γέλια, αναστεναγμοί, βήχας και μεγάλες παύσεις. Υψηλότερη ευαισθησία πιάνει πιο απαλές αντιδράσεις."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התאם את רגישות הזיהוי של צחוק, אנחות, שיעול והפסקות ארוכות. רגישות גבוהה קולטת תגובות חלשות ומאפשרת סריקה מחדש."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte citlivost detekce smíchu, povzdechů, kašle a dlouhých pauz. Vyšší citlivost zachytí tišší reakce a umožní znovu naskenovat stávající poznámky."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustați ușurința cu care sunt detectate râsetele, oftaturile, tusea și pauzele lungi. Sensibilitatea mai mare captează reacțiile mai slabe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítsa be a nevetés, sóhajtás, köhögés és hosszú szünetek érzékelési küszöbét. A nagyobb érzékenység a halkabb reakciókat is észleli."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laraskan betapa mudah ketawa, keluhan, batuk dan jeda panjang dikesan. Kepekaan lebih tinggi merakam reaksi perlahan dan membolehkan imbasan semula nota."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta amb quina facilitat es detecten rialles, sospirs, tos i pauses llargues. Més sensibilitat capta reaccions més suaus i permet reescanejar notes."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilagodite koliko se lako otkrivaju smijeh, uzdasi, kašalj i duge stanke. Veća osjetljivost hvata tiše reakcije i omogućuje ponovno skeniranje bilješki."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte citlivosť detekcie smiechu, povzdychov, kašľa a dlhých páuz. Vyššia citlivosť zachytí tichšie reakcie a umožní znova preskenovať poznámky."
          }
        }
      }
    },
