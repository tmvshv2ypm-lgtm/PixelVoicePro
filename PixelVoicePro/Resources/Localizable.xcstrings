        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chào mừng đến với phòng thí nghiệm AI ứng dụng xử lý âm thanh thời gian thực."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยินดีต้อนรับสู่ห้องปฏิบัติการปัญญาประดิษฐ์สำหรับการประมวลผลเสียงแบบเรียลไทม์"
          }
        },
        "sv": {
          "stringUnit": {
