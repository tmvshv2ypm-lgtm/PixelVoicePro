    "ai.refine.reprocess_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-transcribes saved audio using %@ and re-scans laughter, sighs, and pauses at current sensitivity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a transcribir el audio guardado usando %@ y re-escanea risas, suspiros y pausas con la sensibilidad actual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcreve novamente o áudio salvo com %@ e reescaneia risos, suspiros e pausas na sensibilidade atual."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcreve novamente o áudio guardado com %@ e reexamina risos, suspiros e pausas na sensibilidade atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторно транскрибирует сохранённое аудио через %@ и сканирует смех, вздохи и паузы с текущей чувствительностью."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 사용해 저장된 오디오를 다시 받아쓰고 현재 감도로 웃음·한숨·침묵을 재탐지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@ 重新转录已保存的音频，并按当前灵敏度重新扫描笑声、叹息和停顿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@ 重新轉錄已儲存的音訊，並依目前靈敏度重新掃描笑聲、嘆息與停頓。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を使って保存済み音声を再文字起こしし、現在の感度で笑い・ため息・無音を再検出します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retranscrit l'audio enregistré via %@ et rescane rires, soupirs et pauses selon la sensibilité actuelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkribiert gespeichertes Audio erneut mit %@ und scannt Lachen, Seufzer und Pausen mit aktueller Empfindlichkeit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritrascrive l'audio salvato con %@ e riscansiona risate, sospiri e pause alla sensibilità attuale."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد نسخ الصوت المحفوظ باستخدام %@ ويعيد مسح الضحك والتنهد والوقفات بالحساسية الحالية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ का उपयोग करके सहेजे गए ऑडियो का फिर से अनुलेखन करता है और वर्तमान संवेदनशीलता से हंसी व आह स्कैन करता है।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı sesi %@ ile yeniden yazıya döker ve mevcut hassasiyetle gülme, iç çekme ve duraklamaları yeniden tarar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribeert opgeslagen audio opnieuw met %@ en scant lachen, zuchten en pauzes met de huidige gevoeligheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponownie transkrybuje zapisane audio przez %@ i skanuje śmiech, westchnienia oraz pauzy z bieżącą czułością."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторно транскрибує аудіо за допомогою %@ та перескановує сміх, зітхання й паузи з поточною чутливістю."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentranskripsi ulang audio tersimpan dengan %@ dan memindai tawa, helaan napas, dan jeda pada sensitivitas saat ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chép lại âm thanh đã lưu bằng %@ và quét lại tiếng cười, thở dài, khoảng lặng theo độ nhạy hiện tại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถอดเสียงที่บันทึกไว้ซ้ำด้วย %@ และสแกนเสียงหัวเราะ ถอนหายใจ และความเงียบตามความไวปัจจุบัน"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkriberar om sparat ljud med %@ och skannar skratt, suckar och pauser med aktuell känslighet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Transskriberer gemt lyd igen med %@ og genscanner latter, suk og pauser ved aktuel følsomhed."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkriberer lagret lyd på nytt med %@ og skanner latter, sukk og pauser med gjeldende følsomhet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Litteroi tallennetun äänen uudelleen (%@) ja skannaa naurut, huokaukset ja tauot nykyisellä herkkyydellä."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απομαγνητοφωνεί ξανά τον ήχο με %@ και σαρώνει γέλια, αναστεναγμούς και παύσεις με την τρέχουσα ευαισθησία."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתמלל מחדש את השמע השמור באמצעות %@ וסורק צחוק, אנחות והפסקות ברגישות הנוכחית."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu přepíše uložené audio pomocí %@ a naskenuje smích, povzdechy a pauzy podle aktuální citlivosti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Retranscrie audio-ul salvat folosind %@ și rescanează râsetele, oftaturile și pauzele la sensibilitatea curentă."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újraátírja a mentett hangot (%@) és a jelenlegi érzékenységgel újraelemzi a nevetést, sóhajt és szüneteket."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentranskripsi semula audio disimpan menggunakan %@ dan mengimbas semula ketawa, keluhan dan jeda pada kepekaan semasa."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna a transcriure l'àudio desat amb %@ i reescaneja rialles, sospirs i pauses amb la sensibilitat actual."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno transkribira spremljeni zvuk pomoću %@ i skenira smijeh, uzdahe i stanke uz trenutnu osjetljivost."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova prepíše uložené audio pomocou %@ a preskenuje smiech, povzdychy a pauzy pri aktuálnej citlivosti."
          }
        }
      }
    },
