        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कभी भी अस्पष्ट सापेक्ष तिथियों का उपयोग न करें"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asla belirsiz göreceli tarihler kullanmayın"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik nooit vage relatieve datums"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nigdy nie używaj niejednoznacznych dat względnych"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніколи не використовувати нечіткі відносні дати"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan pernah gunakan tanggal relatif yang ambigu"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không bao giờ dùng ngày tương đối mơ hồ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้ามใช้วันที่แบบไม่เจาะจง"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd aldrig otydliga relativa datum"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug aldrig tvetydige relative datoer"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk aldri tvetydige relative datoer"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älä koskaan käytä epämääräisiä suhteellisia päivämääriä"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μην χρησιμοποιείτε ποτέ ασαφείς σχετικές ημερομηνίες"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לעולם אל תשתמש בתאריכים יחסיים עמומים"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikdy nepoužívejte nejednoznačná relativní data"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu folosi niciodată date relative ambigue"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Soha ne használj kétértelmű relatív dátumokat"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan sesekali guna tarikh relatif yang samar-samar"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Prohibit usar dates relatives ambigües"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikada nemojte koristiti dvosmislene relativne datume"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikdy nepoužívajte nejednoznačné relatívne dátumy"
          }
        }
      }
