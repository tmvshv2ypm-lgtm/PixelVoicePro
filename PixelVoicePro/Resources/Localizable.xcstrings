    "sample3.turn1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Important reminder: all cards must show day, month, year, and exact time to the second with AM or PM."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorio importante: todas las tarjetas deben mostrar el formato día, mes, año y la hora exacta hasta el segundo con AM o PM."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembrete importante: todos os cartões devem mostrar dia, mês, ano e hora exata até o segundo com AM ou PM."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembrete importante: todos os cartões devem mostrar dia, mês, ano e hora exata ao segundo com AM ou PM."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Важное напоминание: на всех карточках должны отображаться день, месяц, год и точное время до секунды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중요 알림: 모든 카드에는 일, 월, 연도 및 AM/PM이 포함된 초 단위 정확 시각이 표시되어야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重要提示：所有卡片必须显示日、月、年以及精确到秒的 AM/PM 时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重要提示：所有卡片必須顯示日、月、年以及精確至秒的 AM/PM 時間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重要なお知らせ：すべてのカードに日・月・年と AM/PM 付きの秒単位時刻を表示してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappel important : toutes les cartes doivent afficher le jour, le mois, l'année et l'heure exacte à la seconde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wichtiger Hinweis: Alle Karten müssen Tag, Monat, Jahr und die sekundengenaue Uhrzeit mit AM/PM anzeigen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria importante: tutte le schede devono mostrare giorno, mese, anno e l'ora esatta al secondo con AM o PM."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكير مهم: يجب أن تعرض جميع البطاقات اليوم والشهر والسنة والوقت الدقيق بالثانية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "महत्वपूर्ण अनुस्मारक: सभी कार्डों पर दिन, माह, वर्ष और AM/PM के साथ सेकंड तक का सटीक समय दिखना चाहिए।"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önemli hatırlatma: Tüm kartlarda gün, ay, yıl ve saniyesine kadar kesin saat gösterilmelidir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Belangrijke herinnering: alle kaarten moeten dag, maand, jaar en exacte tijd tot op de seconde tonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ważne przypomnienie: wszystkie karty muszą pokazywać dzień, miesiąc, rok i dokładny czas co do sekundy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Важливе нагадування: усі картки повинні показувати день, місяць, рік і точний час до секунди."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat penting: semua kartu harus menampilkan hari, bulan, tahun, dan waktu tepat hingga detik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu ý quan trọng: mọi thẻ phải hiển thị ngày, tháng, năm và thời gian chính xác đến từng giây."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อควรจำสำคัญ: การ์ดทั้งหมดต้องแสดงวัน เดือน ปี และเวลาที่แม่นยำระดับวินาที"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Viktig påminnelse: alla kort måste visa dag, månad, år och exakt tid på sekunden."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vigtig påmindelse: alle kort skal vise dag, måned, år og præcis tid på sekundet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viktig påminnelse: alle kort må vise dag, måned, år og nøyaktig tid på sekundet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tärkeä muistutus: kaikissa korteissa on oltava päivä, kuukausi, vuosi ja tarkka aika sekunnilleen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σημαντική υπενθύμιση: όλες οι κάρτες πρέπει να δείχνουν ημέρα, μήνα, έτος και ακριβή ώρα στο δευτερόλεπτο."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תזכורת חשובה: כל הכרטיסים חייבים להציג יום, חודש, שנה ושעה מדויקת עד השנייה."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Důležité upozornění: všechny karty musí zobrazovat den, měsíc, rok a přesný čas na sekundy."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Memento important: toate cardurile trebuie să arate ziua, luna, anul și ora exactă la secundă."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fontos emlékeztető: minden kártyának mutatnia kell a napot, hónapot, évet és a pontos időt másodpercre."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan penting: semua kad mesti memaparkan hari, bulan, tahun dan masa tepat hingga saat."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatori important: totes les targetes han de mostrar dia, mes, any i l'hora exacta fins al segon."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Važan podsjetnik: sve kartice moraju prikazivati dan, mjesec, godinu i točno vrijeme u sekundu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dôležitá pripomienka: všetky karty musia zobrazovať deň, mesiac, rok a presný čas na sekundy."
          }
        }
      }
    },
